{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Evidence-local proposed closed output; semantic invariants also required by rules.json and design document",
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldHex",
        "bytesHex",
        "encoding",
        "stringOffset"
      ],
      "properties": {
        "fieldHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "minLength": 16,
          "maxLength": 16
        },
        "bytesHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "encoding": {
          "enum": [
            "inline",
            "string-table"
          ]
        },
        "stringOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "sectionCount",
        "timestamp",
        "symbolTableOffset",
        "symbolSlotCount",
        "optionalHeaderBytes",
        "characteristics"
      ],
      "properties": {
        "machine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sectionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "symbolTableOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "symbolSlotCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "optionalHeaderBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "characteristics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "virtualAddress",
        "symbolSlot",
        "type",
        "offsetInSection",
        "width"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "virtualAddress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "symbolSlot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "offsetInSection": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "name",
        "value",
        "sectionNumber",
        "type",
        "storageClass",
        "auxiliaryCount",
        "classification",
        "auxiliary"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sectionNumber": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "storageClass": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "auxiliaryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "classification": {
          "enum": [
            "section-defined",
            "undefined",
            "common",
            "absolute",
            "debug"
          ]
        },
        "auxiliary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "hex"
            ],
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})*$",
                "minLength": 36,
                "maxLength": 36
              }
            }
          }
        }
      }
    },
    "Directive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionIndex",
        "offset",
        "bytes",
        "hex",
        "infoFlag"
      ],
      "properties": {
        "sectionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "infoFlag": {
          "type": "boolean"
        }
      }
    },
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "virtualSize",
        "virtualAddress",
        "rawSize",
        "rawOffset",
        "relocationOffset",
        "lineOffset",
        "relocationCount",
        "lineCount",
        "characteristics",
        "rawSha256",
        "relocations"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "virtualSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "virtualAddress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "rawSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "rawOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "relocationOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "lineOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "relocationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "lineCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "characteristics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "rawSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "relocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relocation"
          }
        }
      }
    },
    "Inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "format",
        "input",
        "header",
        "sections",
        "symbols",
        "stringTable",
        "directives",
        "fltused"
      ],
      "properties": {
        "kind": {
          "const": "inventory"
        },
        "format": {
          "const": "coff-amd64-standard"
        },
        "input": {
          "$ref": "#/$defs/Identity"
        },
        "header": {
          "$ref": "#/$defs/Header"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Symbol"
          }
        },
        "stringTable": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "offset",
                "bytes",
                "sha256"
              ],
              "properties": {
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "directives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Directive"
          }
        },
        "fltused": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbolSlots",
            "relocationSites"
          ],
          "properties": {
            "symbolSlots": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "relocationSites": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sectionIndex",
                  "relocationIndex"
                ],
                "properties": {
                  "sectionIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "relocationIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              }
            }
          }
        }
      }
    },
    "Rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "input",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "rejected"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "offset"
          ],
          "properties": {
            "code": {
              "enum": [
                "INPUT_TYPE",
                "INPUT_LIMIT",
                "TRUNCATED_HEADER",
                "UNSUPPORTED_ARCHIVE",
                "UNSUPPORTED_IMAGE",
                "UNSUPPORTED_ANONYMOUS",
                "UNSUPPORTED_MACHINE",
                "UNSUPPORTED_OPTIONAL_HEADER",
                "SECTION_LIMIT",
                "SYMBOL_LIMIT",
                "RELOCATION_LIMIT",
                "STRING_LIMIT",
                "NAME_LIMIT",
                "DIRECTIVE_LIMIT",
                "TRUNCATED_SECTIONS",
                "TRUNCATED_RAW",
                "RAW_POINTER",
                "UNSUPPORTED_BSS_RELOCATIONS",
                "UNSUPPORTED_LINES",
                "UNSUPPORTED_RELOCATION_OVERFLOW",
                "RELOCATION_POINTER",
                "TRUNCATED_RELOCATIONS",
                "UNSUPPORTED_RELOCATION_TYPE",
                "RELOCATION_ADDRESS",
                "RELOCATION_SYMBOL",
                "SYMBOL_POINTER",
                "TRUNCATED_SYMBOLS",
                "TRUNCATED_STRINGS",
                "STRING_SIZE",
                "AUXILIARY_RANGE",
                "SYMBOL_SECTION",
                "NAME_OFFSET",
                "NAME_TERMINATOR",
                "NAME_PADDING",
                "SECTION_NAME_ENCODING",
                "OVERLAP",
                "NAME_TOTAL_LIMIT",
                "OUTPUT_LIMIT"
              ]
            },
            "offset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Inventory"
    },
    {
      "$ref": "#/$defs/Rejected"
    }
  ]
}
