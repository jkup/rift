// INERT SOURCE PROPOSAL. No compilation or process execution authorized.
// A recorder, never a linker. All terminal paths hold for job termination.
using System;
using System.IO;
using System.Text;
using System.Threading;
using System.Runtime.InteropServices;

public static class LinkCommandRecorder {
  const string Root = @"C:\Users\jonku\code\rift\typescript\build\ts035e3h-link-command-observation\capture";
  const int RecordLimit=1048576, TextLimit=32767, EnvLimit=131072, ArgLimit=4096;
  static uint pid; static ulong created; static uint stage;
  [DllImport("kernel32.dll")] static extern uint GetCurrentProcessId();
  [DllImport("kernel32.dll")] static extern IntPtr GetCurrentProcess();
  [DllImport("kernel32.dll",SetLastError=true)] static extern bool GetProcessTimes(IntPtr p,out long c,out long e,out long k,out long u);
  [DllImport("kernel32.dll")] static extern IntPtr GetCommandLineW();
  [DllImport("kernel32.dll",SetLastError=true)] static extern IntPtr GetEnvironmentStringsW();
  [DllImport("kernel32.dll",SetLastError=true)] static extern bool FreeEnvironmentStringsW(IntPtr p);
  [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)] static extern uint GetCurrentDirectoryW(uint n,[Out] char[] b);
  [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)] static extern uint GetModuleFileNameW(IntPtr h,[Out] char[] b,uint n);
  [DllImport("shell32.dll",CharSet=CharSet.Unicode,SetLastError=true)] static extern IntPtr CommandLineToArgvW(IntPtr line,out int count);
  [DllImport("kernel32.dll")] static extern IntPtr LocalFree(IntPtr p);
  sealed class Fault : Exception { public readonly uint Code; public Fault(uint c){Code=c;} }
  static void Need(bool b,uint c){if(!b)throw new Fault(c);}
  static void Hold(){while(true)Thread.Sleep(1000);}
  static string Key(){return pid.ToString("x8")+"-"+created.ToString("x16");}
  static void Magic(BinaryWriter w,string s){foreach(char c in s)w.Write((byte)c);}
  static byte[] Identity(string magic,uint detail,ulong tail){using(var m=new MemoryStream()){using(var w=new BinaryWriter(m,Encoding.UTF8,true)){Magic(w,magic);w.Write(pid);w.Write(detail);w.Write(created);w.Write(tail);}return m.ToArray();}}
  static void Publish(string path,byte[] bytes){
    // CreateNew is the arbitration primitive; no Exists-then-create race.
    using(var f=new FileStream(path,FileMode.CreateNew,FileAccess.Write,FileShare.None)){
      f.Write(bytes,0,bytes.Length);f.Flush(true);
    } // A Dispose/close exception prevents the caller from publishing completion.
  }
  static string Text(IntPtr p,int limit){Need(p!=IntPtr.Zero,10);var b=new StringBuilder();for(int i=0;i<=limit;i++){ushort u=(ushort)Marshal.ReadInt16(p,checked(i*2));if(u==0)return b.ToString();Need(i<limit,11);b.Append((char)u);}throw new Fault(11);}
  static string EnvironmentBlock(){
    IntPtr p=GetEnvironmentStringsW();Need(p!=IntPtr.Zero,12);try{
      var b=new StringBuilder();bool zero=false;
      for(int i=0;i<EnvLimit;i++){char u=(char)(ushort)Marshal.ReadInt16(p,checked(i*2));b.Append(u);if(u==0&&zero)return b.ToString();zero=u==0;}
      throw new Fault(13);
    }finally{Need(FreeEnvironmentStringsW(p),14);}
  }
  static string DirectoryName(){var b=new char[TextLimit+1];uint n=GetCurrentDirectoryW((uint)b.Length,b);Need(n>0&&n<b.Length,15);return new string(b,0,(int)n);}
  static string ImageName(){var b=new char[TextLimit+1];uint n=GetModuleFileNameW(IntPtr.Zero,b,(uint)b.Length);Need(n>0&&n<b.Length,16);return new string(b,0,(int)n);}
  static void Units(BinaryWriter w,string s){Need(w.BaseStream.Length+4L+2L*s.Length<=RecordLimit,17);w.Write((uint)s.Length);foreach(char u in s)w.Write((ushort)u);}
  static byte[] Capture(){
    IntPtr raw=GetCommandLineW();string line=Text(raw,TextLimit),cwd=DirectoryName(),image=ImageName(),env=EnvironmentBlock();
    int count;IntPtr args=CommandLineToArgvW(raw,out count);Need(args!=IntPtr.Zero,18);
    try{Need(count>=0&&count<=ArgLimit,19);using(var m=new MemoryStream()){using(var w=new BinaryWriter(m,Encoding.UTF8,true)){
      Magic(w,"RCAP0001");w.Write(pid);w.Write((uint)0);w.Write(created);
      Units(w,line);Units(w,cwd);Units(w,image);Units(w,env);w.Write((uint)count);
      for(int i=0;i<count;i++)Units(w,Text(Marshal.ReadIntPtr(args,checked(i*IntPtr.Size)),TextLimit));
      Need(m.Length<=RecordLimit,17);
    }return m.ToArray();}}finally{Need(LocalFree(args)==IntPtr.Zero,20);}
  }
  static void Failure(uint code){
    // Failures retain the first marker; failure to publish is not hidden success.
    // A missing/partial record or marker is incomplete; pre-entry failure remains unobservable.
    try{Publish(Path.Combine(Root,"failure-"+Key()+".bin"),Identity("RERR0001",code,stage));}catch{}
  }
  public static void Main(){
    try{
      stage=1;pid=GetCurrentProcessId();long c=0,e=0,k=0,u=0;Need(pid!=0&&GetProcessTimes(GetCurrentProcess(),out c,out e,out k,out u),1);created=unchecked((ulong)c);Need(created!=0,1);
      stage=2;Need(Environment.GetEnvironmentVariable("RIFT_LINK_CAPTURE")==Path.Combine(Root,"first-command.bin"),2);
      // Entry is durable BEFORE competing for winner. Every cooperative loser remains visible.
      stage=3;Publish(Path.Combine(Root,"entry-"+Key()+".bin"),Identity("RENT0001",0,0));
      stage=4;
      try{Publish(Path.Combine(Root,"winner.bin"),Identity("RWIN0001",0,0));}
      catch(IOException ex){int code=ex.HResult&65535;if(code==80||code==183){Failure(3);Hold();return;}throw;}
      stage=5;byte[] record=Capture();
      stage=6;Publish(Path.Combine(Root,"first-command.bin"),record);
      stage=7;Publish(Path.Combine(Root,"record-complete"),Identity("RDON0001",0,(ulong)record.Length));
    }catch(Fault f){Failure(f.Code);}catch(Exception){Failure(255);}
    Hold();
  }
}
