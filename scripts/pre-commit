#!/bin/bash
# Pre-commit hook for Rift JavaScript Runtime
# This script runs code quality checks before allowing commits

set -e

echo "Running pre-commit code quality checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Check if we're in a git repository
if [ ! -d ".git" ]; then
    print_status $RED "Error: Not in a git repository"
    exit 1
fi

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp)$' || true)

if [ -z "$STAGED_FILES" ]; then
    print_status $GREEN "No C++ files to check"
    exit 0
fi

print_status $YELLOW "Checking ${#STAGED_FILES[@]} C++ files..."

# Create build directory if it doesn't exist
if [ ! -d "build" ]; then
    mkdir build
fi

# Configure CMake if needed
if [ ! -f "build/Makefile" ]; then
    print_status $YELLOW "Configuring CMake..."
    cd build
    cmake .. -DCMAKE_BUILD_TYPE=Debug
    cd ..
fi

# Check 1: clang-format
print_status $YELLOW "1. Checking code formatting with clang-format..."
if command -v clang-format >/dev/null 2>&1; then
    FORMAT_ISSUES=0
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ]; then
            # Check if file needs formatting
            if ! clang-format --dry-run --Werror -style=file "$FILE" >/dev/null 2>&1; then
                print_status $RED "Formatting issues found in: $FILE"
                FORMAT_ISSUES=1
            fi
        fi
    done
    
    if [ $FORMAT_ISSUES -eq 1 ]; then
        print_status $RED "❌ Code formatting check failed!"
        print_status $YELLOW "Run 'make format' to fix formatting issues"
        exit 1
    fi
    print_status $GREEN "✅ Code formatting check passed"
else
    print_status $YELLOW "⚠️  clang-format not found, skipping formatting check"
fi

# Check 2: Build check
print_status $YELLOW "2. Checking if code compiles..."
cd build
if make -j$(nproc 2>/dev/null || echo 4) >/dev/null 2>&1; then
    print_status $GREEN "✅ Code compilation check passed"
else
    print_status $RED "❌ Code compilation failed!"
    cd ..
    exit 1
fi
cd ..

# Check 3: clang-tidy (only for modified files)
print_status $YELLOW "3. Running clang-tidy on modified files..."
if command -v clang-tidy >/dev/null 2>&1; then
    TIDY_ISSUES=0
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ]; then
            # Run clang-tidy on individual file
            if ! clang-tidy -p build "$FILE" --quiet 2>/dev/null; then
                print_status $RED "Static analysis issues found in: $FILE"
                TIDY_ISSUES=1
            fi
        fi
    done
    
    if [ $TIDY_ISSUES -eq 1 ]; then
        print_status $YELLOW "⚠️  Static analysis issues found (not blocking commit)"
        print_status $YELLOW "Run 'make clang-tidy' to see detailed issues"
    else
        print_status $GREEN "✅ Static analysis check passed"
    fi
else
    print_status $YELLOW "⚠️  clang-tidy not found, skipping static analysis"
fi

# Check 4: Basic tests
print_status $YELLOW "4. Running basic functionality tests..."
if [ -f "build/rift" ]; then
    if ./build/rift test/basic-arithmetic.js >/dev/null 2>&1; then
        print_status $GREEN "✅ Basic tests passed"
    else
        print_status $RED "❌ Basic tests failed!"
        exit 1
    fi
else
    print_status $YELLOW "⚠️  Rift executable not found, skipping tests"
fi

print_status $GREEN "🎉 All pre-commit checks passed!"
exit 0 