{
  "name": "rift-ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "scriptc": "0.4.7",
    "typescript": "7.0.2",
    "yaml": "2.8.3"
  },
  "scripts": {
    "test:observations": "node tools/test262/observation.integration.mjs",
    "test:test262": "node --test tools/test262/*.test.mjs",
    "test:runner": "node --test tools/probe-verdict.test.mjs tools/native-build-runner.test.mjs tools/legacy-suite.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:probes": "node tools/run-probes.mjs",
    "build:node": "tsc -p tsconfig.json",
    "build:native": "node tools/build-native.mjs",
    "test:guest:node": "npm run build:node && node tools/run-guests.mjs node",
    "test:guest:native": "npm run build:native && node tools/run-guests.mjs native"
  }
}
