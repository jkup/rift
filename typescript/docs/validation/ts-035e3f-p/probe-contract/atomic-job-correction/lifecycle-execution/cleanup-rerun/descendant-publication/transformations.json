      "replacements": [
        {
          "old": "import {writeFileSync} from 'node:fs';",
          "next": "import {writeFileSync,openSync,fsyncSync,closeSync,linkSync} from 'node:fs';"
        },
        {
          "old": " child.once('spawn',()=>{writeFileSync(join(root,'descendant-pid.txt'),String(child.pid)+'\\n',{flag:'wx'});child.unref();process.exit(0);});",
          "next": " child.once('spawn',()=>{\n  const published=join(root,'descendant-pid.txt'),staging=published+'.pending';\n  const fd=openSync(staging,'wx');\n  let failure;\n  try {writeFileSync(fd,String(child.pid)+'\\n');fsyncSync(fd);}catch(e){failure=e;}\n  try {closeSync(fd);}catch(e){if(failure!==undefined)throw new AggregateError([failure,e],'descendant-pid-write-and-close');throw e;}\n  if(failure!==undefined)throw failure;\n  // Publish closed, complete bytes without replacing an existing name.\n  // Retain the staging alias as evidence; never write either path again.\n  linkSync(staging,published);\n  child.unref();process.exit(0);\n });"
        }
      ]
    },
