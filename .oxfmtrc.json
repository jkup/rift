{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "printWidth": 100,
    "sortImports": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        "build/**",
        "node_modules/**",
        ".cache/**",
        ".scriptc/**",
        "docs/validation/**",
        "test/fixtures/**",
        "examples/**",
        "src/time-zone/iana-timezone-data.ts",
        "src/time-zone/iana-timezone-identifiers.ts",
        "src/unicode/unicode-properties.ts",
        "src/unicode/unicode-identifiers.ts",
        "src/unicode/unicode-case-fold.ts",
        "test/cases.json",
        "tools/**/*.json"
    ]
}
