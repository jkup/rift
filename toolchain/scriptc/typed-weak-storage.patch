+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, test } from "vitest";
+import { compile } from "../src/index.js";
+
+const programs = [
+  `class Key { peer: Key | null = null; }
+class DerivedKey extends Key { extra = 1; }
+type Value = { kind: "undefined" } | { kind: "object"; object: Key };
+class Holder { properties: Map<string, Value> = new Map(); }
+const key = new DerivedKey(); key.peer = key;
+const value = new Holder();
+value.properties.set("owner", { kind: "object", object: key });
+const map = new WeakMap<Key, Holder>(); map.set(key, value);
+console.log(map.get(key) === value, key.extra);`,
+  `class Key { peer: Key | null = null; }
+class Holder { label = "holder"; }
+class DerivedHolder extends Holder {
+  owner: Key;
+  constructor(owner: Key) { super(); this.owner = owner; }
+}
+const key = new Key(); key.peer = key;
+const value = new DerivedHolder(key);
+const map = new WeakMap<Key, Holder>(); map.set(key, value);
+console.log(map.get(key) === value, value.owner === key);`,
+];
+
+test.each(programs)(
+  "weak ownership covers hierarchy and tagged record paths: %s",
+  async (source) => {
+    const directory = await mkdtemp(join(tmpdir(), "scriptc-weak-ownership-"));
+    try {
+      const entry = join(directory, "main.ts");
+      const outPath = join(directory, "main.ll");
+      await writeFile(entry, source);
+      const result = await compile(entry, {
+        tier: "static-only",
+        outDir: directory,
+        outPath,
+        outputKind: "llvm",
+      });
+      expect(result.ok, JSON.stringify(result.diagnostics)).toBe(true);
+      if (!result.ok) return;
+      const llvm = await readFile(outPath, "utf8");
+      expect(llvm).toMatch(/call ptr @scr_typed_weak_map_new_owned\(/);
+      expect(llvm).not.toMatch(/call ptr @scr_typed_weak_map_new\(/);
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  },
+);
