@@ -0,0 +1,21 @@
+/* scriptc runtime: value-independent weak-key indexing (scr_weak_index.c). */
+#ifndef SCR_WEAK_INDEX_H
+#define SCR_WEAK_INDEX_H
+
+#include "scr_rc.h"
+
+/* Owners allocate links and unlink them before freeing their storage.
+ * A disposal callback must remove its link before releasing owned values. */
+typedef struct ScrWeakLink {
+  void *key;
+  void *owner;
+  unsigned kind;
+  void (*dispose)(struct ScrWeakLink *);
+  struct ScrWeakLink *key_next, *key_prev;
+} ScrWeakLink;
+
+ScrWeakLink *scr_weak_link_find(void *owner, void *key, unsigned kind);
+void scr_weak_link_insert(ScrWeakLink *entry);
+void scr_weak_link_remove(ScrWeakLink *entry);
+
+#endif
