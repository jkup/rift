diff --git a/packages/runtime/test/test_typed_weak_map.c b/packages/runtime/test/test_typed_weak_map.c
new file mode 100644
index 0000000000000000000000000000000000000000..2a3150d6601b70bddb66c09deb5767bc9c49df4d
--- /dev/null
+++ b/packages/runtime/test/test_typed_weak_map.c
@@ -0,0 +1,304 @@
+#include "../src/scr_typed_weak_map.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+_Noreturn void scr_trap(const char *message) { fputs(message, stderr); exit(1); }
+static void check(bool condition, const char *message) { if (!condition) scr_trap(message); }
+static size_t refs_freed, nodes_freed;
+static void *dispose_on_release;
+typedef struct { size_t rc; } Ref;
+static Ref *ref_new(void) {
+  Ref *ref = malloc(sizeof *ref);
+  check(ref != NULL, "allocation failed\n");
+  ref->rc = 1;
+  return ref;
+}
+static void *ref_retain(void *ptr) { if (ptr) ((Ref *)ptr)->rc++; return ptr; }
+static void ref_release(void *ptr) {
+  if (!ptr || --((Ref *)ptr)->rc) return;
+  refs_freed++;
+  free(ptr);
+  if (dispose_on_release) {
+    void *key = dispose_on_release;
+    dispose_on_release = NULL;
+    scr_weak_dispose_inline(key);
+  }
+}
+static const ScrWeakValueOps ref_ops = { ref_retain, ref_release, NULL };
+
+typedef struct Node { size_t rc; struct Node *next; ScrTypedWeakMap *owner; } Node;
+static void node_trace(void *ptr, ScrTraceVisit visit, void *ctx) {
+  Node *node = ptr;
+  visit(node->next, ctx);
+  visit(node->owner, ctx);
+}
+static void node_free(void *ptr) {
+  scr_weak_dispose_inline(ptr);
+  nodes_freed++;
+  scr_cyc_free(ptr);
+}
+static Node *node_new(void) {
+  static ScrCycType type = { .trace = node_trace, .free_fn = node_free };
+  Node *node = scr_cyc_alloc(sizeof *node, &type);
+  node->rc = 1;
+  return node;
+}
+static void *node_retain(void *ptr) { if (ptr) SCR_RC_COUNT(ptr)++; return ptr; }
+static void node_release(void *ptr) {
+  Node *node = ptr;
+  if (!node) return;
+  if (--SCR_RC_COUNT(node)) { scr_cyc_released(node); return; }
+  scr_cyc_dead(node);
+  node_release(node->next);
+  scr_typed_weak_map_release(node->owner);
+  node_free(node);
+}
+static const ScrWeakValueOps node_ops = { node_retain, node_release, node_trace };
+static uint64_t bits(void *ptr) { return (uint64_t)(uintptr_t)ptr; }
+
+typedef struct { size_t rc; Ref *key; } Holder;
+static size_t holders_freed;
+static const ScrOwnership ref_ownership = {0};
+static void holder_trace(void *ptr, ScrOwnedVisit visit, void *ctx) {
+  visit(((Holder *)ptr)->key, &ref_ownership, ctx);
+}
+static const ScrOwnership holder_ownership = { .trace = holder_trace };
+static void *holder_retain(void *ptr) { if (ptr) ((Holder *)ptr)->rc++; return ptr; }
+static void holder_release(void *ptr) {
+  Holder *holder = ptr;
+  if (!holder || --holder->rc) return;
+  scr_weak_dispose_inline(holder);
+  ref_release(holder->key);
+  holders_freed++;
+  free(holder);
+}
+static const ScrWeakValueOps holder_ops = { holder_retain, holder_release, NULL };
+static void check_acyclic_backreference(void) {
+  for (unsigned root = 0; root < 3; root++) {
+    size_t keys_before = refs_freed, values_before = holders_freed;
+    Ref *key = ref_new();
+    Holder *value = malloc(sizeof *value);
+    check(value != NULL, "allocation failed\n");
+    *value = (Holder){ .rc = 1, .key = ref_retain(key) };
+    ScrTypedWeakMap *map = scr_typed_weak_map_new_owned(false, &holder_ops,
+        &ref_ownership, &holder_ownership);
+    scr_typed_weak_map_set(map, key, bits(holder_retain(value)));
+    if (root != 1) ref_release(key);
+    if (root != 2) holder_release(value);
+    scr_collect_cycles();
+    if (root) {
+      check(refs_freed == keys_before && holders_freed == values_before,
+          "acyclic backreference lost an external root\n");
+      check(scr_typed_weak_map_has(map, key), "rooted entry disappeared\n");
+      if (root == 1) ref_release(key); else holder_release(value);
+      scr_collect_cycles();
+    }
+    check(refs_freed == keys_before + 1 && holders_freed == values_before + 1,
+        "acyclic value kept its dead key alive\n");
+    scr_typed_weak_map_release(map);
+  }
+}
+
+static Holder *side_owner;
+static void side_ownership(void *object, ScrOwnedVisit visit, void *ctx) {
+  if (object == side_owner) visit(side_owner->key, &ref_ownership, ctx);
+}
+static void check_side_ownership(void) {
+  size_t before = refs_freed, values_before = holders_freed;
+  static const ScrOwnership opaque = {0};
+  Ref *key = ref_new();
+  Holder *value = malloc(sizeof *value);
+  check(value != NULL, "allocation failed\n");
+  *value = (Holder){ .rc = 1, .key = ref_retain(key) };
+  side_owner = value;
+  scr_record_ownership_hook = side_ownership;
+  ScrTypedWeakMap *map = scr_typed_weak_map_new_owned(false, &holder_ops, &ref_ownership, &opaque);
+  scr_typed_weak_map_set(map, key, bits(value));
+  ref_release(key);
+  scr_collect_cycles();
+  side_owner = NULL;
+  scr_record_ownership_hook = NULL;
+  check(refs_freed == before + 1 && holders_freed == values_before + 1,
+      "side-table ownership retained a dead weak entry\n");
+  scr_typed_weak_map_release(map);
+}
+
+static void check_conditional_values(void) {
+  size_t before = nodes_freed;
+  ScrTypedWeakMap *map = scr_typed_weak_map_new(true, &node_ops);
+  Node *key = node_new();
+  key->next = node_retain(key);
+  scr_typed_weak_map_set(map, key, bits(node_retain(key)));
+  node_release(key);
+  scr_collect_cycles();
+  check(nodes_freed == before + 1, "self-value kept a dead key alive\n");
+  scr_typed_weak_map_release(map);
+
+  before = nodes_freed;
+  map = scr_typed_weak_map_new(true, &node_ops);
+  key = node_new();
+  Node *value = node_new();
+  value->next = node_retain(key);
+  scr_typed_weak_map_set(map, key, bits(node_retain(value)));
+  node_release(key);
+  scr_collect_cycles();
+  uint64_t found = 0;
+  check(nodes_freed == before && scr_typed_weak_map_get(map, key, &found) && found == bits(value),
+        "external value did not preserve its key\n");
+  node_release((void *)(uintptr_t)found);
+  node_release(value);
+  scr_collect_cycles();
+  check(nodes_freed == before + 2, "value backreference survived without a root\n");
+  scr_typed_weak_map_release(map);
+
+  size_t refs_before = refs_freed;
+  map = scr_typed_weak_map_new(false, &ref_ops);
+  Ref *plain = ref_new();
+  scr_typed_weak_map_set(map, plain, bits(ref_retain(plain)));
+  ref_release(plain);
+  scr_collect_cycles();
+  check(refs_freed == refs_before + 1, "acyclic self-value survived\n");
+  size_t immortal_key = SIZE_MAX;
+  scr_typed_weak_map_set(map, &immortal_key, bits(ref_new()));
+  scr_collect_cycles();
+  check(refs_freed == refs_before + 1 && scr_typed_weak_map_has(map, &immortal_key), "immortal key lost its value\n");
+  scr_typed_weak_map_release(map);
+  check(refs_freed == refs_before + 2, "immortal-key owner cleanup\n");
+}
+
+static void check_conditional_ring(void) {
+  enum { COUNT = 6000 };
+  Node **keys = calloc(COUNT, sizeof *keys);
+  check(keys != NULL, "allocation failed\n");
+  size_t before = nodes_freed;
+  ScrTypedWeakMap *map = scr_typed_weak_map_new(true, &node_ops);
+  ScrTypedWeakMap *other = scr_typed_weak_map_new(true, &node_ops);
+  for (size_t i = 0; i < COUNT; i++) keys[i] = node_new();
+  for (size_t i = 0; i < COUNT; i++)
+    scr_typed_weak_map_set(i % 2 ? other : map, keys[i], bits(node_retain(keys[(i + 1) % COUNT])));
+  for (size_t i = 1; i < COUNT; i++) node_release(keys[i]);
+  scr_collect_cycles();
+  check(nodes_freed == before && scr_typed_weak_map_has(other, keys[COUNT - 1]), "rooted weak chain lost a key\n");
+  node_release(keys[0]);
+  scr_collect_cycles();
+  check(nodes_freed == before + COUNT, "unrooted weak ring survived\n");
+  scr_typed_weak_map_release(map);
+  scr_typed_weak_map_release(other);
+  free(keys);
+}
+
+static void check_automatic_collection(void) {
+  enum { COUNT = 200000 };
+  size_t before = nodes_freed;
+  ScrTypedWeakMap *map = scr_typed_weak_map_new(true, &node_ops);
+  for (size_t i = 0; i < COUNT; i++) {
+    Node *key = node_new();
+    key->next = node_retain(key);
+    scr_typed_weak_map_set(map, key, bits(node_retain(key)));
+    node_release(key);
+  }
+  check(nodes_freed > before, "automatic weak collection made no progress\n");
+  scr_collect_cycles();
+  check(nodes_freed == before + COUNT, "automatic workload left dead keys\n");
+  scr_typed_weak_map_release(map);
+}
+
+static void check_nested_maps(void) {
+  static const ScrWeakValueOps map_ops = {
+    scr_typed_weak_map_retain_v, scr_typed_weak_map_release_v, scr_typed_weak_map_trace_v
+  };
+  size_t key = 1, before = nodes_freed;
+  ScrTypedWeakMap *outer = scr_typed_weak_map_new(false, &map_ops);
+  ScrTypedWeakMap *inner = scr_typed_weak_map_new(false, &node_ops);
+  Node *node = node_new();
+  node->owner = scr_typed_weak_map_retain(outer);
+  scr_typed_weak_map_set(inner, &key, bits(node));
+  scr_typed_weak_map_set(outer, &key, bits(inner));
+  scr_typed_weak_map_release(outer);
+  scr_collect_cycles();
+  check(nodes_freed == before + 1, "nested weak-map cycle survived\n");
+}
+
+static void check_region_keys(void) {
+#if SIZE_MAX > UINT32_MAX
+  size_t before = refs_freed;
+  size_t keys[] = { (size_t)SCR_RC_HIGH_LIFETIME << 32, (size_t)SCR_RC_HIGH_LIFETIME << 32 };
+  ScrTypedWeakMap *map = scr_typed_weak_map_new(false, &ref_ops);
+  for (size_t i = 0; i < 2; i++) scr_typed_weak_map_set(map, &keys[i], bits(ref_new()));
+  scr_collect_cycles();
+  check(scr_typed_weak_map_has(map, &keys[0]) && scr_typed_weak_map_has(map, &keys[1]),
+      "live region key was treated as an unreferenced object\n");
+  scr_weak_dispose_inline(&keys[0]);
+  check(!scr_typed_weak_map_has(map, &keys[0]) && refs_freed == before + 1,
+      "region disposal did not remove its weak entry\n");
+  scr_weak_dispose_inline(&keys[1]);
+  check(refs_freed == before + 2, "region disposal retained weak values\n");
+  uint32_t compact = SCR_RC_COMPACT_TAG | 17;
+  scr_typed_weak_map_set(map, &compact, bits(ref_new()));
+  scr_collect_cycles();
+  check(scr_typed_weak_map_has(map, &compact), "compact lifetime key was discarded\n");
+  scr_weak_dispose_inline(&compact);
+  check(refs_freed == before + 3, "compact disposal retained its weak value\n");
+  scr_typed_weak_map_release(map);
+#endif
+}
+
+int main(void) {
+  size_t keys[3] = {1, 1, 1};
+  ScrTypedWeakMap *map = scr_typed_weak_map_new(false, NULL);
+  uint64_t value = 123;
+  check(!scr_typed_weak_map_get(map, &keys[0], &value) && value == 123, "missing scalar read\n");
+  scr_typed_weak_map_set(map, &keys[0], UINT64_MAX);
+  check(scr_typed_weak_map_get(map, &keys[0], &value) && value == UINT64_MAX, "scalar bits changed\n");
+  scr_typed_weak_map_set(map, &keys[0], 0);
+  check(scr_typed_weak_map_get(map, &keys[0], &value) && value == 0, "zero confused with absence\n");
+  check(scr_typed_weak_map_delete(map, &keys[0]) && !scr_typed_weak_map_delete(map, &keys[0]), "delete result\n");
+  scr_typed_weak_map_set(map, &keys[0], 42);
+  scr_weak_dispose_inline(&keys[0]);
+  check(!scr_typed_weak_map_has(map, &keys[0]), "disposed scalar key survives\n");
+  scr_typed_weak_map_release(map);
+
+  map = scr_typed_weak_map_new(false, &ref_ops);
+  Ref *first = ref_new();
+  scr_typed_weak_map_set(map, &keys[0], bits(first));
+  check(first->rc == 1, "set did not move ownership\n");
+  check(scr_typed_weak_map_get(map, &keys[0], &value) && value == bits(first) && first->rc == 2, "get did not retain\n");
+  ref_release((void *)(uintptr_t)value);
+  scr_typed_weak_map_set(map, &keys[1], bits(ref_new()));
+  dispose_on_release = &keys[1];
+  scr_typed_weak_map_set(map, &keys[0], bits(ref_new()));
+  check(refs_freed == 2 && !scr_typed_weak_map_has(map, &keys[1]), "replacement cascade\n");
+  scr_typed_weak_map_set(map, &keys[2], 0);
+  check(scr_typed_weak_map_get(map, &keys[2], &value) && value == 0, "null reference value\n");
+  scr_typed_weak_map_release(map);
+  check(refs_freed == 3, "owner teardown leaked reference\n");
+
+  map = scr_typed_weak_map_new(false, &node_ops);
+  Node *node = node_new();
+  node->owner = scr_typed_weak_map_retain(map);
+  scr_typed_weak_map_set(map, &keys[0], bits(node));
+  scr_typed_weak_map_release(map);
+  scr_collect_cycles();
+  check(nodes_freed == 1, "map/value cycle survived\n");
+
+  map = scr_typed_weak_map_new(true, &ref_ops);
+  node = node_new();
+  node->next = node_retain(node);
+  scr_typed_weak_map_set(map, node, bits(ref_new()));
+  node_release(node);
+  scr_collect_cycles();
+  check(nodes_freed == 2 && refs_freed == 4, "collected key did not release acyclic value\n");
+  scr_typed_weak_map_release(map);
+  scr_collect_cycles();
+  check_nested_maps();
+  check_conditional_values();
+  check_acyclic_backreference();
+  check_side_ownership();
+  check_region_keys();
+  check_conditional_ring();
+  check_automatic_collection();
+  scr_collect_cycles();
+  check(scr_cyc_live == 0, "typed weak-map test left collector objects\n");
+  puts("typed weak map checks passed");
+  return 0;
+}
diff --git a/packages/runtime/test/test_weak_index.c b/packages/runtime/test/test_weak_index.c
new file mode 100644
index 0000000000000000000000000000000000000000..459c9a120e0b41477105eafa4ad2702a45fc0b0a
--- /dev/null
+++ b/packages/runtime/test/test_weak_index.c
@@ -0,0 +1,100 @@
+#include "../src/scr_runtime.h"
+#include "../src/scr_weak_index.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+enum { KEY_COUNT = 4096, ENTRY_COUNT = KEY_COUNT * 4 };
+typedef struct {
+  ScrWeakLink link;
+  bool active;
+} Entry;
+static Entry entries[ENTRY_COUNT];
+static size_t keys[KEY_COUNT], owners[2], disposed;
+static void *cascade_from, *cascade_to;
+
+_Noreturn void scr_trap(const char *message) {
+  fputs(message, stderr);
+  exit(1);
+}
+
+static void check(bool condition, const char *message) {
+  if (!condition) scr_trap(message);
+}
+
+static void dispose(ScrWeakLink *link) {
+  Entry *entry = (Entry *)link;
+  check(entry->active, "duplicate disposal\n");
+  scr_weak_link_remove(link);
+  entry->active = false;
+  disposed++;
+  if (link->key == cascade_from) scr_weak_dispose(cascade_to);
+}
+
+static void insert(size_t index, size_t key, size_t owner, unsigned kind) {
+  Entry *entry = &entries[index];
+  entry->link = (ScrWeakLink){ .key = &keys[key], .owner = &owners[owner], .kind = kind, .dispose = dispose };
+  entry->active = true;
+  scr_weak_link_insert(&entry->link);
+}
+
+static ScrWeakLink *sibling;
+static size_t heap_disposed;
+
+static void dispose_heap(ScrWeakLink *link) {
+  scr_weak_link_remove(link);
+  free(link);
+  heap_disposed++;
+  if (sibling) {
+    ScrWeakLink *other = sibling;
+    sibling = NULL;
+    dispose_heap(other);
+  }
+}
+
+static ScrWeakLink *insert_heap(size_t owner) {
+  ScrWeakLink *link = calloc(1, sizeof *link);
+  check(link != NULL, "allocation failed\n");
+  *link = (ScrWeakLink){ .key = &keys[0], .owner = &owners[owner], .dispose = dispose_heap };
+  scr_weak_link_insert(link);
+  return link;
+}
+
+int main(void) {
+  for (size_t i = 0; i < ENTRY_COUNT; i++) insert(i, i / 4, (i / 2) % 2, i % 2);
+  for (size_t i = 0; i < ENTRY_COUNT; i++) {
+    ScrWeakLink *link = &entries[i].link;
+    check(scr_weak_link_find(link->owner, link->key, link->kind) == link, "identity lookup failed\n");
+  }
+  size_t removed = 0;
+  for (size_t i = 0; i < ENTRY_COUNT; i += 3) {
+    scr_weak_link_remove(&entries[i].link);
+    entries[i].active = false;
+    removed++;
+  }
+  for (size_t i = 0; i < ENTRY_COUNT; i++) {
+    ScrWeakLink *link = &entries[i].link;
+    check(scr_weak_link_find(link->owner, link->key, link->kind) == (entries[i].active ? link : NULL), "deletion broke a lookup chain\n");
+  }
+  for (size_t i = 0; i < KEY_COUNT; i++) scr_weak_dispose(&keys[i]);
+  check(disposed == ENTRY_COUNT - removed, "key disposal missed an owner or kind\n");
+  for (size_t i = 0; i < ENTRY_COUNT; i++) {
+    ScrWeakLink *link = &entries[i].link;
+    check(!entries[i].active && !scr_weak_link_find(link->owner, link->key, link->kind), "disposed key still indexed\n");
+  }
+  size_t before = disposed;
+  insert(0, 0, 0, 0);
+  insert(1, 1, 1, 0);
+  insert(2, 0, 1, 0);
+  cascade_from = &keys[0];
+  cascade_to = &keys[1];
+  scr_weak_dispose(&keys[0]);
+  check(disposed == before + 3 && !entries[0].active && !entries[1].active && !entries[2].active,
+        "reentrant disposal or address reuse failed\n");
+  sibling = insert_heap(0);
+  insert_heap(1);
+  scr_weak_dispose(&keys[0]);
+  check(heap_disposed == 2 && !scr_weak_link_find(&owners[0], &keys[0], 0) &&
+        !scr_weak_link_find(&owners[1], &keys[0], 0), "callback-owned entries survived disposal\n");
+  puts("weak index checks passed");
+  return 0;
+}
diff --git a/packages/runtime/test/test_weak_record_source.c b/packages/runtime/test/test_weak_record_source.c
new file mode 100644
index 0000000000000000000000000000000000000000..c1c31e9fc2a1e17ee2938108afabb4eb3b5cd1b6
--- /dev/null
+++ b/packages/runtime/test/test_weak_record_source.c
@@ -0,0 +1,222 @@
+#include "../src/scr_runtime.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct { size_t rc; } Ref;
+static size_t freed;
+static void check(bool ok, const char *message) {
+  if (!ok) { fputs(message, stderr); exit(1); }
+}
+static Ref *ref_new(void) {
+  Ref *ref = malloc(sizeof *ref);
+  check(ref != NULL, "allocation failed\n");
+  ref->rc = 1;
+  return ref;
+}
+static void *ref_retain(void *ptr) { ((Ref *)ptr)->rc++; return ptr; }
+static void ref_release(void *ptr) {
+  if (!ptr || --((Ref *)ptr)->rc) return;
+  scr_weak_dispose_inline(ptr);
+  freed++;
+  free(ptr);
+}
+static const ScrOwnership ownership = {0};
+static const ScrWeakValueOps ops = { ref_retain, ref_release, NULL };
+
+static void check_source(unsigned shape, bool rooted, bool borrowed) {
+  size_t before = freed;
+  Ref *key = ref_new(), *value = ref_new();
+  ScrDyn *capsule = scr_dyn_new_typed_ref(key, ref_retain, ref_release,
+      "record:key", 10, NULL, NULL);
+  if (borrowed) {
+    ScrDynTypedCast *cast = calloc(1, sizeof *cast);
+    check(cast != NULL, "allocation failed\n");
+    cast->ptr = key;
+    cast->borrowed = true;
+    capsule->v.typed_ref.casts = cast;
+    ref_retain(key);
+  }
+  ScrDyn *payload = capsule;
+  if (shape == 1) {
+    payload = scr_dyn_new_arr();
+    scr_dyn_arr_push(payload, capsule);
+    scr_dyn_arr_push(payload, scr_dyn_retain(capsule));
+  } else if (shape == 2) {
+    payload = scr_dyn_new_obj();
+    scr_dyn_obj_set(payload, "key", 3, capsule);
+  }
+  ScrDyn *source = scr_dyn_new_obj();
+  scr_dyn_obj_set(source, "hidden", 6, payload);
+  scr_record_source_note(value, source, NULL, NULL, 0);
+  check(scr_record_source_has(value), "missing record source\n");
+  ScrTypedWeakMap *map = scr_typed_weak_map_new_owned(false, &ops, &ownership, &ownership);
+  scr_typed_weak_map_set(map, key, (uint64_t)(uintptr_t)value);
+  ref_release(key);
+  if (!rooted) scr_dyn_release(source);
+  scr_collect_cycles();
+  if (rooted || borrowed) {
+    check(freed == before, "live external reference was reclaimed\n");
+    check(scr_typed_weak_map_has(map, key), "live key lost its value\n");
+    if (rooted) scr_dyn_release(source);
+    if (borrowed) ref_release(key);
+    scr_collect_cycles();
+  }
+  check(freed == before + 2, "hidden backreference retained the key and value\n");
+  scr_typed_weak_map_release(map);
+}
+
+typedef struct { size_t rc; Ref *key; } Holder;
+static void holder_trace(void *ptr, ScrOwnedVisit visit, void *ctx) {
+  visit(((Holder *)ptr)->key, &ownership, ctx);
+}
+static const ScrOwnership holder_ownership = { .trace = holder_trace };
+static void holder_release(void *ptr) {
+  Holder *holder = ptr;
+  if (--holder->rc) return;
+  scr_weak_dispose_inline(holder);
+  ref_release(holder->key);
+  freed++;
+  free(holder);
+}
+static void check_native_payload(bool rooted) {
+  size_t before = freed;
+  Ref *key = ref_new(), *value = ref_new();
+  Holder *holder = malloc(sizeof *holder);
+  check(holder != NULL, "allocation failed\n");
+  *holder = (Holder){ .rc = 1, .key = ref_retain(key) };
+  ScrDyn *capsule = scr_dyn_new_typed_ref(holder, ref_retain, holder_release,
+      "record:holder", 13, NULL, NULL);
+  scr_dyn_typed_ref_bind_ownership(capsule, "record:other", 12, &ownership);
+  scr_dyn_typed_ref_bind_ownership(capsule, "record:holder", 13, &holder_ownership);
+  scr_dyn_typed_ref_bind_ownership(capsule, "record:holder", 13, &holder_ownership);
+  ScrDyn *source = scr_dyn_new_obj();
+  scr_dyn_obj_set(source, "hidden", 6, capsule);
+  scr_record_source_note(value, source, NULL, NULL, 0);
+  scr_dyn_release(source);
+  ScrTypedWeakMap *map = scr_typed_weak_map_new_owned(false, &ops, &ownership, &ownership);
+  scr_typed_weak_map_set(map, key, (uint64_t)(uintptr_t)value);
+  ref_release(key);
+  if (!rooted) holder_release(holder);
+  scr_collect_cycles();
+  if (rooted) {
+    check(freed == before, "external native payload was reclaimed\n");
+    check(scr_typed_weak_map_has(map, key), "native payload lost its weak key\n");
+    holder_release(holder);
+    scr_collect_cycles();
+  }
+  check(freed == before + 3, "native capsule payload retained its weak key\n");
+  scr_typed_weak_map_release(map);
+}
+
+typedef struct { size_t rc; ScrDyn *properties; } DynamicHolder;
+static void dynamic_holder_trace(void *ptr, ScrOwnedVisit visit, void *ctx) {
+  visit(((DynamicHolder *)ptr)->properties, &scr_dyn_ownership, ctx);
+}
+static const ScrOwnership dynamic_holder_ownership = { .trace = dynamic_holder_trace };
+static void dynamic_holder_release(void *ptr) {
+  DynamicHolder *holder = ptr;
+  if (--holder->rc) return;
+  scr_weak_dispose_inline(holder);
+  scr_dyn_release(holder->properties);
+  freed++;
+  free(holder);
+}
+static void check_dynamic_field(bool rooted) {
+  size_t before = freed;
+  Ref *key = ref_new();
+  ScrDyn *properties = scr_dyn_new_obj();
+  scr_dyn_obj_set(properties, "key", 3, scr_dyn_new_typed_ref(key,
+      ref_retain, ref_release, "record:key", 10, NULL, NULL));
+  DynamicHolder *holder = malloc(sizeof *holder);
+  check(holder != NULL, "allocation failed\n");
+  *holder = (DynamicHolder){ .rc = 1, .properties = scr_dyn_retain(properties) };
+  static const ScrWeakValueOps dynamic_ops = { ref_retain, dynamic_holder_release, NULL };
+  ScrTypedWeakMap *map = scr_typed_weak_map_new_owned(false, &dynamic_ops,
+      &ownership, &dynamic_holder_ownership);
+  scr_typed_weak_map_set(map, key, (uint64_t)(uintptr_t)holder);
+  ref_release(key);
+  if (!rooted) scr_dyn_release(properties);
+  scr_collect_cycles();
+  if (rooted) {
+    check(freed == before, "external dynamic properties were reclaimed\n");
+    check(scr_typed_weak_map_has(map, key), "dynamic properties lost their key\n");
+    scr_dyn_release(properties);
+    scr_collect_cycles();
+  }
+  check(freed == before + 2, "dynamic field retained its weak key\n");
+  scr_typed_weak_map_release(map);
+}
+
+static void map_owned(void *ptr, ScrOwnedVisit visit, void *ctx) {
+  scr_map_trace_owned(ptr, NULL, &ownership, visit, ctx);
+}
+static void set_owned(void *ptr, ScrOwnedVisit visit, void *ctx) {
+  scr_map_trace_owned(ptr, &ownership, NULL, visit, ctx);
+}
+static const ScrOwnership map_ownership = { .trace = map_owned };
+static const ScrOwnership set_ownership = { .trace = set_owned };
+static void check_collection(bool set, bool rooted, bool dynamic) {
+  size_t before = freed;
+  Ref *key = ref_new(), *value = ref_new();
+  static const ScrMapOps map_ops = { .val_retain = ref_retain, .val_release = ref_release };
+  static const ScrMapOps set_ops = { .key_retain = ref_retain, .key_release = ref_release };
+  ScrMap *collection = scr_map_new(dynamic ? SCR_MAP_KEY_DYN : set ? SCR_MAP_KEY_REF : SCR_MAP_KEY_F64,
+      set ? SCR_MAP_VAL_F64 : SCR_MAP_VAL_REF,
+      dynamic ? (set ? &scr_map_dyn_set_ops : &scr_map_dyn_map_ops) : (set ? &set_ops : &map_ops));
+  if (dynamic) {
+    ScrDyn *capsule = scr_dyn_new_typed_ref(key, ref_retain, ref_release,
+        "record:key", 10, NULL, NULL);
+    if (set) {
+      scr_map_set_ref_f64(collection, capsule, 1);
+      scr_dyn_release(capsule);
+    } else {
+      ScrDyn *index = scr_dyn_new_num(1);
+      scr_map_set_ref_ref(collection, index, capsule);
+      scr_dyn_release(index);
+    }
+  } else if (set) scr_map_set_ref_f64(collection, key, 1);
+  else scr_map_set_f64_ref(collection, 1, ref_retain(key));
+  ScrDyn *wrapper = set ? scr_dyn_native_set(collection) : scr_dyn_native_map(collection);
+  if (!dynamic) scr_dyn_collection_bind_ownership(wrapper, set ? &set_ownership : &map_ownership);
+  scr_map_release(collection);
+  ScrDyn *source = scr_dyn_new_obj();
+  scr_dyn_obj_set(source, "hidden", 6, wrapper);
+  scr_record_source_note(value, source, NULL, NULL, 0);
+  ScrTypedWeakMap *map = scr_typed_weak_map_new_owned(false, &ops, &ownership, &ownership);
+  scr_typed_weak_map_set(map, key, (uint64_t)(uintptr_t)value);
+  ref_release(key);
+  if (!rooted) scr_dyn_release(source);
+  scr_collect_cycles();
+  if (rooted) {
+    check(freed == before, "externally held collection was reclaimed\n");
+    check(scr_typed_weak_map_has(map, key), "collection lost its live weak key\n");
+    scr_dyn_release(source);
+    scr_collect_cycles();
+  }
+  check(freed == before + 2, "collection wrapper retained its weak key\n");
+  scr_typed_weak_map_release(map);
+}
+
+int main(void) {
+  for (unsigned shape = 0; shape < 3; shape++) {
+    check_source(shape, false, false);
+    check_source(shape, true, false);
+    check_source(shape, false, true);
+  }
+  for (unsigned i = 0; i < 8; i++) {
+    check_native_payload(false);
+    check_native_payload(true);
+    check_dynamic_field(false);
+    check_dynamic_field(true);
+    check_collection(false, false, false);
+    check_collection(false, true, false);
+    check_collection(true, false, false);
+    check_collection(true, true, false);
+    check_collection(false, false, true);
+    check_collection(false, true, true);
+    check_collection(true, false, true);
+    check_collection(true, true, true);
+  }
+  puts("record-source weak ownership checks passed");
+  return 0;
+}
