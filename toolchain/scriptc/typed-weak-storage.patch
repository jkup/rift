+/* scriptc runtime: conditional weak-value reachability (scr_ephemeron.c). */
+#ifndef SCR_EPHEMERON_H
+#define SCR_EPHEMERON_H
+
+#include "scr_rc.h"
+
+/* Immutable metadata for every owned reference, including acyclic fields.
+ * Each trace visits every direct strong edge once and supplies the child
+ * descriptor. NULL root metadata retains the legacy cycle-only walk. */
+typedef struct ScrOwnership ScrOwnership;
+typedef void (*ScrOwnedVisit)(void *object, const ScrOwnership *ownership, void *ctx);
+struct ScrOwnership {
+  bool traced;
+  void (*trace)(void *object, ScrOwnedVisit visit, void *ctx);
+};
+
+/* Owners have cycle headers and own only conditional value edges. Traced
+ * keys/values have cycle headers; other references have ordinary RC words.
+ * A snapshot borrows everything until detach transfers the value ownership.
+ * detach must not release values or invoke disposal callbacks. */
+typedef struct {
+  void *owner, *key, *value, *entry;
+  bool key_traced, value_traced;
+  const ScrOwnership *key_ownership, *value_ownership;
+  void (*detach)(void *entry);
+  void (*release)(void *value);
+} ScrEphemeron;
+typedef void (*ScrEphemeronVisit)(const ScrEphemeron *, void *);
+typedef struct ScrEphemeronProvider {
+  void (*enumerate)(ScrEphemeronVisit, void *);
+  struct ScrEphemeronProvider *next;
+} ScrEphemeronProvider;
+
+/* Optional record-source side-table edges, installed only by the dynamic runtime. */
+extern SCR_TL void (*scr_record_ownership_hook)(void *, ScrOwnedVisit, void *);
+
+/* Providers are thread-local, live for the thread, and register once by identity. */
+void scr_ephemeron_register(ScrEphemeronProvider *provider);
+
+#endif
