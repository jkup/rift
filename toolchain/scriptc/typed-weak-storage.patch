+import { execFile } from "node:child_process";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { promisify } from "node:util";
+import { expect, test } from "vitest";
+import { compile } from "../src/index.js";
+
+const run = promisify(execFile);
+const runtime = fileURLToPath(new URL("../../runtime/src/", import.meta.url));
+
+test.each([
+  { layout: "tagged", collection: "WeakMap", backreference: true, growth: 0 },
+  { layout: "tagged", collection: "Map", backreference: true, growth: 50 },
+  { layout: "tagged", collection: "WeakMap", backreference: false, growth: 0 },
+  { layout: "derived", collection: "WeakMap", backreference: true, growth: 0 },
+])(
+  "weak ownership lifetime: $layout $collection backreference=$backreference",
+  async (scenario) => {
+    const directory = await mkdtemp(join(tmpdir(), "scriptc-weak-lifetime-"));
+    try {
+      const windows = process.platform === "win32";
+      const observer = join(directory, "observer.c");
+      const object = join(directory, windows ? "observer.obj" : "observer.o");
+      const library = join(directory, windows ? "observer.lib" : "observer.a");
+      await writeFile(
+        observer,
+        '#include "scr_rc.h"\ndouble weak_live(void) { scr_collect_cycles(); return (double)scr_cyc_live; }\n',
+      );
+      await run(windows ? "zig" : (process.env.SCRIPTC_CC ?? "clang"), [
+        ...(windows ? ["cc"] : []),
+        "-O2",
+        "-c",
+        "-I",
+        runtime,
+        observer,
+        "-o",
+        object,
+      ]);
+      await run(windows ? "zig" : "ar", [...(windows ? ["ar"] : []), "rcs", library, object]);
+      const ffi = join(directory, "ffi.json");
+      await writeFile(
+        ffi,
+        JSON.stringify({
+          ffi_format: 1,
+          libraries: [library],
+          functions: [{ name: "live", symbol: "weak_live", params: [], returns: "f64" }],
+        }),
+      );
+      const holder =
+        scenario.layout === "tagged"
+          ? `type Value = { kind: "undefined" } | { kind: "object"; object: Key };
+class Holder { properties: Map<string, Value> = new Map(); }
+function makeValue(key: Key): Holder {
+  const value = new Holder();
+  value.properties.set("owner", ${scenario.backreference ? '{ kind: "object", object: key }' : '{ kind: "undefined" }'});
+  return value;
+}`
+          : `class Holder { label = "holder"; }
+class DerivedHolder extends Holder {
+  owner: Key;
+  constructor(owner: Key) { super(); this.owner = owner; }
+}
+function makeValue(key: Key): Holder { return new DerivedHolder(key); }`;
+      const entry = join(directory, "main.ts");
+      await writeFile(
+        entry,
+        `declare function live(): number;
+class Key { prototype: Key | null = null; }
+class DerivedKey extends Key { extra = 1; }
+${holder}
+const map = new ${scenario.collection}<Key, Holder>();
+const kept = new DerivedKey(); kept.prototype = kept;
+const keptValue = makeValue(kept); map.set(kept, keptValue);
+function fill(): void {
+  for (let i = 0; i < 50; i++) {
+    const key = new DerivedKey(); key.prototype = key;
+    map.set(key, makeValue(key));
+  }
+}
+console.log(live());
+for (let batch = 0; batch < 3; batch++) {
+  fill(); console.log(live());
+  if (map.get(kept) !== keptValue || kept.prototype !== kept) throw new Error("lost rooted key");
+}
+`,
+      );
+      const binary = join(directory, windows ? "program.exe" : "program");
