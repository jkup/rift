diff --git a/packages/runtime/src/scr_ephemeron.c b/packages/runtime/src/scr_ephemeron.c
new file mode 100644
index 0000000000000000000000000000000000000000..cc49b5ec4a38ac2ebf9086aff6d25d197affd4d3
--- /dev/null
+++ b/packages/runtime/src/scr_ephemeron.c
@@ -0,0 +1,233 @@
+#include "scr_ephemeron.h"
+#include <stdlib.h>
+
+typedef struct {
+  void *object;
+  size_t incoming, waiting;
+  bool traced, owner, live;
+  const ScrOwnership *ownership;
+} ScrWeakNode;
+typedef struct {
+  ScrWeakNode *nodes;
+  size_t *slots, count, capacity;
+  size_t *queue, head, tail, queue_capacity;
+} ScrWeakGraph;
+typedef struct { size_t entry, next; } ScrWeakWait;
+typedef struct { ScrEphemeron *entries; size_t count, capacity; } ScrWeakSnapshot;
+static SCR_TL ScrEphemeronProvider *scr_ephemeron_providers;
+SCR_TL void (*scr_record_ownership_hook)(void *, ScrOwnedVisit, void *) = NULL;
+
+static void *scr_weak_resize(void *ptr, size_t count, size_t size) {
+  if (count > SIZE_MAX / size) scr_trap("scriptc: weak graph too large\n");
+  void *result = realloc(ptr, count * size);
+  if (!result) scr_trap("scriptc: out of memory\n");
+  return result;
+}
+
+static size_t scr_weak_hash(void *object) {
+  uint64_t bits = (uintptr_t)object;
+  bits ^= bits >> 33;
+  bits *= UINT64_C(0xff51afd7ed558ccd);
+  bits ^= bits >> 29;
+  return (size_t)bits;
+}
+
+static void scr_weak_enqueue(ScrWeakGraph *graph, size_t index) {
+  if (graph->tail == graph->queue_capacity) {
+    graph->queue_capacity = graph->queue_capacity ? graph->queue_capacity * 2 : 64;
+    graph->queue = scr_weak_resize(graph->queue, graph->queue_capacity, sizeof *graph->queue);
+  }
+  graph->queue[graph->tail++] = index;
+}
+
+/* Region references count their chunk, not this word. Disposal removes their entries. */
+static bool scr_weak_external_lifetime(const void *object) {
+  if (!object || scr_rc_immortal(object)) return true;
+#if SIZE_MAX > UINT32_MAX
+  ScrRcCount tag = SCR_RC_COUNT(object) & ~(SCR_RC_COMPACT_ID_MASK | SCR_RC_COMPACT_PUBLISHED);
+  if (tag == SCR_RC_COMPACT_TAG) return true;
+  if (*(const size_t *)object & ((size_t)SCR_RC_HIGH_LIFETIME << 32)) return true;
+#endif
+  return false;
+}
+
+static size_t scr_weak_node(ScrWeakGraph *graph, void *object, bool traced, const ScrOwnership *ownership) {
+  if (scr_weak_external_lifetime(object)) return SIZE_MAX;
+  if (!graph->capacity || graph->count * 2 >= graph->capacity) {
+    size_t capacity = graph->capacity ? graph->capacity * 2 : 64;
+    size_t *slots = scr_weak_resize(NULL, capacity, sizeof *slots);
+    memset(slots, 0, capacity * sizeof *slots);
+    graph->nodes = scr_weak_resize(graph->nodes, capacity, sizeof *graph->nodes);
+    for (size_t i = 0; i < graph->count; i++) {
+      size_t slot = scr_weak_hash(graph->nodes[i].object) & (capacity - 1);
+      while (slots[slot]) slot = (slot + 1) & (capacity - 1);
+      slots[slot] = i + 1;
+    }
+    free(graph->slots);
+    graph->slots = slots;
+    graph->capacity = capacity;
+  }
+  size_t slot = scr_weak_hash(object) & (graph->capacity - 1);
+  while (graph->slots[slot]) {
+    size_t index = graph->slots[slot] - 1;
+    if (graph->nodes[index].object == object) {
+      if ((!graph->nodes[index].traced && traced) || (!graph->nodes[index].ownership && ownership)) {
+        graph->nodes[index].traced |= traced;
+        if (ownership) graph->nodes[index].ownership = ownership;
+        scr_weak_enqueue(graph, index);
+      }
+      return index;
+    }
+    slot = (slot + 1) & (graph->capacity - 1);
+  }
+  size_t index = graph->count++;
+  graph->nodes[index] = (ScrWeakNode){ .object = object, .waiting = SIZE_MAX, .traced = traced, .ownership = ownership };
+  graph->slots[slot] = index + 1;
+  scr_weak_enqueue(graph, index);
+  return index;
+}
+
+static size_t scr_weak_lookup(ScrWeakGraph *graph, void *object) {
+  if (scr_weak_external_lifetime(object)) return SIZE_MAX;
+  size_t slot = scr_weak_hash(object) & (graph->capacity - 1);
+  while (graph->slots[slot]) {
+    size_t index = graph->slots[slot] - 1;
+    if (graph->nodes[index].object == object) return index;
+    slot = (slot + 1) & (graph->capacity - 1);
+  }
+  scr_trap("scriptc: weak graph changed during tracing\n");
+}
+
+static void scr_weak_mark(void *object, void *context) {
+  ScrWeakGraph *graph = context;
+  size_t index = scr_weak_lookup(graph, object);
+  if (index == SIZE_MAX || graph->nodes[index].live) return;
+  graph->nodes[index].live = true;
+  graph->queue[graph->tail++] = index;
+}
+
+static void scr_weak_discover(void *object, void *ctx) {
+  scr_weak_node(ctx, object, true, NULL);
+}
+static void scr_owned_discover(void *object, const ScrOwnership *ownership, void *ctx) {
+  scr_weak_node(ctx, object, ownership && ownership->traced, ownership);
+}
+static void scr_weak_count_edge(void *object, void *ctx) {
+  ScrWeakGraph *graph = ctx;
+  size_t index = scr_weak_lookup(graph, object);
+  if (index != SIZE_MAX) graph->nodes[index].incoming++;
+}
+static void scr_owned_count(void *object, const ScrOwnership *ownership, void *ctx) {
+  (void)ownership;
+  scr_weak_count_edge(object, ctx);
+}
+static void scr_owned_mark(void *object, const ScrOwnership *ownership, void *ctx) {
+  (void)ownership;
+  scr_weak_mark(object, ctx);
+}
+static void scr_weak_walk(ScrWeakNode node, ScrOwnedVisit owned, ScrTraceVisit cycle, void *ctx) {
+  if (node.owner) return;
+  if (scr_record_ownership_hook) scr_record_ownership_hook(node.object, owned, ctx);
+  if (node.ownership) {
+    if (node.ownership->trace) node.ownership->trace(node.object, owned, ctx);
+  } else if (node.traced) {
+    scr_cyc_type(scr_cyc_hdr(node.object))->trace(node.object, cycle, ctx);
+  }
+}
+
+static bool scr_weak_live(ScrWeakGraph *graph, void *object) {
+  size_t index = scr_weak_lookup(graph, object);
+  return index == SIZE_MAX || graph->nodes[index].live;
+}
+
+static void scr_weak_snapshot(const ScrEphemeron *entry, void *context) {
+  ScrWeakSnapshot *snapshot = context;
+  if (snapshot->count == snapshot->capacity) {
+    snapshot->capacity = snapshot->capacity ? snapshot->capacity * 2 : 64;
+    snapshot->entries = scr_weak_resize(snapshot->entries, snapshot->capacity, sizeof *snapshot->entries);
+  }
+  snapshot->entries[snapshot->count++] = *entry;
+}
+
+static void scr_ephemeron_collect(void) {
+  ScrWeakSnapshot snapshot = {0};
+  for (ScrEphemeronProvider *provider = scr_ephemeron_providers; provider; provider = provider->next)
+    provider->enumerate(scr_weak_snapshot, &snapshot);
+  if (!snapshot.count) return;
+  ScrWeakGraph graph = {0};
+  for (size_t i = 0; i < snapshot.count; i++) {
+    ScrEphemeron *entry = &snapshot.entries[i];
+    size_t owner = scr_weak_node(&graph, entry->owner, true, NULL);
+    if (owner != SIZE_MAX) graph.nodes[owner].owner = true;
+    scr_weak_node(&graph, entry->key, entry->key_traced, entry->key_ownership);
+    size_t value = scr_weak_node(&graph, entry->value, entry->value_traced, entry->value_ownership);
+    if (value != SIZE_MAX) graph.nodes[value].incoming++;
+  }
+  while (graph.head < graph.tail) {
+    ScrWeakNode node = graph.nodes[graph.queue[graph.head++]];
+    scr_weak_walk(node, scr_owned_discover, scr_weak_discover, &graph);
+  }
+  for (size_t i = 0; i < graph.count; i++)
+    scr_weak_walk(graph.nodes[i], scr_owned_count, scr_weak_count_edge, &graph);
+  graph.head = graph.tail = 0;
+  graph.queue = scr_weak_resize(graph.queue, graph.count ? graph.count : 1, sizeof *graph.queue);
+  ScrWeakWait *waiting = scr_weak_resize(NULL, snapshot.count * 2, sizeof *waiting);
+  size_t waiting_count = 0;
+  for (size_t i = 0; i < snapshot.count; i++) {
+    void *dependencies[] = { snapshot.entries[i].owner, snapshot.entries[i].key };
+    for (size_t j = 0; j < 2; j++) {
+      size_t index = scr_weak_lookup(&graph, dependencies[j]);
+      if (index == SIZE_MAX) continue;
+      waiting[waiting_count] = (ScrWeakWait){ i, graph.nodes[index].waiting };
+      graph.nodes[index].waiting = waiting_count++;
+    }
+  }
+  for (size_t i = 0; i < graph.count; i++) {
+    ScrWeakNode *node = &graph.nodes[i];
+    size_t refs = SCR_RC_REFS(node->object);
+    if (node->incoming > refs) scr_trap("scriptc: weak graph reference count mismatch\n");
+    if (refs > node->incoming) scr_weak_mark(node->object, &graph);
+  }
+  for (size_t i = 0; i < snapshot.count; i++) {
+    ScrEphemeron *entry = &snapshot.entries[i];
+    if (scr_weak_live(&graph, entry->owner) && scr_weak_live(&graph, entry->key))
+      scr_weak_mark(entry->value, &graph);
+  }
+  while (graph.head < graph.tail) {
+    size_t index = graph.queue[graph.head++];
+    ScrWeakNode node = graph.nodes[index];
+    scr_weak_walk(node, scr_owned_mark, scr_weak_mark, &graph);
+    for (size_t w = node.waiting; w != SIZE_MAX; w = waiting[w].next) {
+      ScrEphemeron *entry = &snapshot.entries[waiting[w].entry];
+      if (scr_weak_live(&graph, entry->owner) && scr_weak_live(&graph, entry->key))
+        scr_weak_mark(entry->value, &graph);
+    }
+  }
+  size_t removed = 0;
+  /* All borrowed entry pointers must be detached before any release can
+   * destroy a key, owner, or another entry in this snapshot. */
+  for (size_t i = 0; i < snapshot.count; i++) {
+    ScrEphemeron entry = snapshot.entries[i];
+    if (!scr_weak_live(&graph, entry.owner) || !scr_weak_live(&graph, entry.key)) {
+      entry.detach(entry.entry);
+      snapshot.entries[removed++] = entry;
+    }
+  }
+  free(waiting);
+  free(graph.queue);
+  free(graph.nodes);
+  free(graph.slots);
+  for (size_t i = 0; i < removed; i++) {
+    ScrEphemeron *entry = &snapshot.entries[i];
+    if (entry->release) entry->release(entry->value);
+  }
+  free(snapshot.entries);
+}
+
+void scr_ephemeron_register(ScrEphemeronProvider *provider) {
+  for (ScrEphemeronProvider *entry = scr_ephemeron_providers; entry; entry = entry->next)
+    if (entry == provider) return;
+  provider->next = scr_ephemeron_providers;
+  scr_ephemeron_providers = provider;
+  scr_weak_collect_hook = scr_ephemeron_collect;
+}
