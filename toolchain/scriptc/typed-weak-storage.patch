--- /dev/null
+++ b/packages/runtime/test/weak-index.test.ts
@@ -0,0 +1,41 @@
+import { execFile } from "node:child_process";
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import { expect, test } from "vitest";
+
+const execFileAsync = promisify(execFile);
+const testDir = import.meta.dirname;
+
+test("weak key indexing preserves identity, deletion chains and reentrant disposal", async () => {
+  const buildDir = join(testDir, "build");
+  await mkdir(buildDir, { recursive: true });
+  const windows = process.platform === "win32";
+  const bin = join(buildDir, windows ? "test_weak_index.exe" : "test_weak_index");
+  await execFileAsync(windows ? "zig" : "clang", [
+    ...(windows ? ["cc"] : []),
+    "-std=c11",
+    "-O1",
+    "-Wall",
+    "-Wextra",
+    "-ffunction-sections",
+    "-fdata-sections",
+    process.platform === "darwin" ? "-Wl,-dead_strip" : "-Wl,--gc-sections",
+    ...(windows ? [] : ["-fsanitize=address,undefined"]),
+    "-o",
+    bin,
+    join(testDir, "test_weak_index.c"),
+    join(testDir, "../src/scr_weak_index.c"),
+    join(testDir, "../src/scr_cycle.c"),
+    join(testDir, "../src/scr_alloc.c"),
+  ]);
+  const run = await execFileAsync(bin, [], {
+    env: {
+      ...process.env,
+      ASAN_OPTIONS: "detect_leaks=0:halt_on_error=1",
+      UBSAN_OPTIONS: "halt_on_error=1",
+    },
+  });
+  expect(run.stdout.replaceAll("\r\n", "\n")).toBe("weak index checks passed\n");
+  expect(run.stderr).toBe("");
+});
diff --git a/packages/runtime/test/weak-record-source.test.ts b/packages/runtime/test/weak-record-source.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8dd3a9209a948a757bf617d653204a2bcf6cd7a6
--- /dev/null
+++ b/packages/runtime/test/weak-record-source.test.ts
@@ -0,0 +1,74 @@
+import { execFile } from "node:child_process";
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import { expect, test } from "vitest";
+
+const run = promisify(execFile);
+const testDir = import.meta.dirname;
+
+test.each([false, true])("record-source weak ownership (nursery=%s)", async (nursery) => {
+  const build = join(testDir, "build");
+  await mkdir(build, { recursive: true });
+  const windows = process.platform === "win32";
+  const binary = join(build, `test_weak_record_source_${nursery}${windows ? ".exe" : ""}`);
+  const units = [
+    "scr_json",
+    "scr_bigint",
+    "scr_string",
+    "scr_array",
+    "scr_arena",
+    "scr_map",
+    "scr_exception",
+    "scr_error",
+    "scr_number",
+    "scr_console",
+    "scr_closure",
+    "scr_object",
+    "scr_union",
+    "scr_cycle",
+    "scr_alloc",
+    "scr_lib",
+    "scr_hash",
+    "scr_url",
+    "scr_url_params",
+    "scr_path",
+    "scr_bytes",
+    "scr_shared",
+    "scr_context",
+    "scr_typed_weak_map",
+    "scr_weak_index",
+    "scr_ephemeron",
+  ];
+  await run(windows ? "zig" : "clang", [
+    ...(windows ? ["cc", "-target", "x86_64-windows-gnu"] : []),
+    "-std=c11",
+    "-O1",
+    "-DSCR_JS_TIER",
+    ...(nursery ? ["-DSCR_YIN"] : []),
+    "-ffunction-sections",
+    "-fdata-sections",
+    process.platform === "darwin" ? "-Wl,-dead_strip" : "-Wl,--gc-sections",
+    ...(windows ? [] : ["-fsanitize=address,undefined"]),
+    ...(process.platform === "linux" ? ["-D_GNU_SOURCE", "-lm"] : []),
+    "-o",
+    binary,
+    join(testDir, "test_weak_record_source.c"),
+    ...(windows ? [join(testDir, "../src/scr_win.c"), "-lws2_32", "-liphlpapi", "-ladvapi32"] : []),
+    ...units.map((unit) => join(testDir, "../src", `${unit}.c`)),
+  ]);
+  for (const threshold of ["1", "7", "4096"]) {
+    const result = await run(binary, [], {
+      env: {
+        ...process.env,
+        SCR_CYCLE_THRESHOLD: threshold,
+        ASAN_OPTIONS: "detect_leaks=0:halt_on_error=1",
+        UBSAN_OPTIONS: "halt_on_error=1",
+      },
+    });
+    expect(result.stdout.replaceAll("\r\n", "\n")).toBe(
+      "record-source weak ownership checks passed\n",
+    );
+    expect(result.stderr).toBe("");
+  }
+});
