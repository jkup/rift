diff --git a/packages/compiler/src/backend/llvm/ownership.ts b/packages/compiler/src/backend/llvm/ownership.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c5f16701fc23e7b672cb61552c1a00d1b9285dcd
--- /dev/null
+++ b/packages/compiler/src/backend/llvm/ownership.ts
@@ -0,0 +1,202 @@
+import { InternalCompilerError } from "../../errors.js";
+import { isRefCounted, typeKey, type IrType } from "../../ir/ir.js";
+import { mangleClassStruct, mangleFunction, mangleRecordStruct } from "../mangle.js";
+import { classFieldIndex, classPreLines } from "./classes.js";
+import { shapeTagFn } from "./nullable-unions.js";
+import type { LlvmEmitterContext } from "./expr-context.js";
+import { recordViewTestLines } from "./record-views.js";
+import { traceArg } from "./shapes.js";
+
+type Field = { type: IrType; index: number };
+type Layout = { struct: string; fields: Field[] };
+type Variant = { tag: number; type: IrType };
+
+export function ownershipDescriptor(host: LlvmEmitterContext, type: IrType): string | null {
+  const layouts = new Map<string, Layout | null>();
+  const types = new Map<string, IrType>();
+  const variants = new Map<string, Variant[]>();
+  const unwrap = (value: IrType): IrType => {
+    if (value.kind !== "union") return value;
+    const nullable = host.nullableUnions.get(value.unionId);
+    return nullable?.repr === "single" ? nullable.arm : value;
+  };
+  const collect = (input: IrType): boolean => {
+    const value = unwrap(input);
+    if (!isRefCounted(value)) return true;
+    const key = typeKey(value);
+    if (types.has(key)) return true;
+    types.set(key, value);
+    if (
+      value.kind === "dyn" ||
+      value.kind === "string" ||
+      value.kind === "bigint" ||
+      value.kind === "weakMap"
+    ) {
+      layouts.set(key, null);
+      return true;
+    }
+    if (value.kind === "array") {
+      if (
+        host.shapeHost.compactArrayElem?.(value.elem) ||
+        [...host.classMeta.values()].some((meta) => meta.def.arrayElem !== undefined)
+      )
+        return false;
+      return collect(value.elem);
+    }
+    if (value.kind === "map") return collect(value.key) && collect(value.value);
+    if (value.kind === "set") return collect(value.elem);
+    if (value.kind === "union") {
+      const union = host.nullableUnions.shapes(value.unionId);
+      if (!union) return false;
+      const arms: Variant[] = union.arms.map((arm) => ({
+        tag: arm.tag,
+        type: { kind: "record", shapeId: arm.shapeId },
+      }));
+      variants.set(key, arms);
+      return arms.every((arm) => collect(arm.type));
+    }
+    let layout: Layout;
+    if (value.kind === "object") {
+      const meta = host.classMeta.get(value.className);
+      if (
+        !meta ||
+        meta.root.def.runtime ||
+        meta.compact ||
+        meta.inlineTail ||
+        meta.def.arrayElem !== undefined
+      )
+        return false;
+      if (meta.children.length > 0) {
+        const descendants = [meta];
+        for (const descendant of descendants) descendants.push(...descendant.children);
+        const arms: Variant[] = descendants.map((descendant) => ({
+          tag: descendant.pre,
+          type: { kind: "object", className: descendant.def.name },
+        }));
+        variants.set(key, arms);
+        if (!arms.every((arm) => collect(arm.type))) return false;
+      }
+      layout = {
+        struct: mangleClassStruct(value.className),
+        fields: meta.def.fields
+          .filter(
+            (field) =>
+              isRefCounted(field.type) &&
+              !host.inlineUnions.classField(value.className, field.name),
+          )
+          .map((field) => ({ type: field.type, index: classFieldIndex(meta, field.name).index })),
+      };
+    } else if (value.kind === "record") {
+      const shape = host.recordsById.get(value.shapeId);
+      if (!shape || shape.indexValue) return false;
+      layout = {
+        struct: mangleRecordStruct(value.shapeId),
+        fields: shape.fields.flatMap((field, index) =>
+          isRefCounted(field.type) && !host.recordFieldInline(value.shapeId, field.name)
+            ? [{ type: field.type, index: index + host.nullableUnions.fieldBase(value.shapeId) }]
+            : [],
+        ),
+      };
+    } else return false;
+    layouts.set(key, layout);
+    return layout.fields.every((field) => collect(field.type));
+  };
+  if (!collect(type)) return null;
+  const symbol = (value: IrType): string =>
+    unwrap(value).kind === "dyn"
+      ? "@scr_dyn_ownership"
+      : `@${mangleFunction("%ownership:" + typeKey(unwrap(value)))}`;
+  for (const [key, value] of types) {
+    const name = symbol(value);
+    if (value.kind === "dyn") {
+      host.declare("@scr_dyn_ownership = external constant { i8, ptr }");
+      continue;
+    }
+    const layout = layouts.get(key);
+    const trace =
+      value.kind === "array" ||
+      value.kind === "map" ||
+      value.kind === "set" ||
+      variants.has(key) ||
+      layout?.fields.length
+        ? `${name}.trace`
+        : "null";
+    host.declare(
+      `${name} = internal constant { i8, ptr } { i8 ${traceArg(host.shapeHost, value) === "null" ? 0 : 1}, ptr ${trace} }`,
+    );
+    if (value.kind === "array") {
+      host.declare("declare void @scr_arr_trace_owned(ptr, ptr, ptr, ptr)");
+      const elem = isRefCounted(value.elem) ? symbol(value.elem) : "null";
+      host.declare(
+        `define internal void ${trace}(ptr %o, ptr %visit, ptr %ctx) {\nentry:\n  call void @scr_arr_trace_owned(ptr %o, ptr ${elem}, ptr %visit, ptr %ctx)\n  ret void\n}`,
+      );
+      continue;
+    }
+    if (value.kind === "map" || value.kind === "set") {
+      host.declare("declare void @scr_map_trace_owned(ptr, ptr, ptr, ptr, ptr)");
+      const key = value.kind === "map" ? value.key : value.elem;
+      const keyDescriptor = isRefCounted(key) ? symbol(key) : "null";
+      const valueDescriptor =
+        value.kind === "map" && isRefCounted(value.value) ? symbol(value.value) : "null";
+      host.declare(
+        `define internal void ${trace}(ptr %o, ptr %visit, ptr %ctx) {\nentry:\n  call void @scr_map_trace_owned(ptr %o, ptr ${keyDescriptor}, ptr ${valueDescriptor}, ptr %visit, ptr %ctx)\n  ret void\n}`,
+      );
+      continue;
+    }
+    const arms = variants.get(key);
+    if (arms) {
+      const lines = [`define internal void ${trace}(ptr %o, ptr %visit, ptr %ctx) {`, "entry:"];
+      let tagType: string;
+      if (value.kind === "union") {
+        tagType = "i32";
+        lines.push(`  %tag = call i32 ${shapeTagFn(value.unionId)}(ptr %o)`);
+      } else if (value.kind === "object") {
+        tagType = host.sizeType;
+        lines.push(
+          ...classPreLines(
+            host.classMeta.get(value.className)!,
+            mangleClassStruct(value.className),
+            "%o",
+            "%tag",
+            host.sizeType,
+          ),
+        );
+      } else throw new InternalCompilerError("unexpected ownership dispatch type");
+      lines.push(
+        `  switch ${tagType} %tag, label %done [ ${arms.map((arm) => `${tagType} ${arm.tag}, label %a${arm.tag}`).join(" ")} ]`,
+      );
+      for (const arm of arms) {
+        lines.push(`a${arm.tag}:`);
+        if (layouts.get(typeKey(arm.type))?.fields.length) {
+          const helper = variants.has(typeKey(arm.type)) ? "fields" : "trace";
+          lines.push(`  call void ${symbol(arm.type)}.${helper}(ptr %o, ptr %visit, ptr %ctx)`);
+        }
+        lines.push("  br label %done");
+      }
+      lines.push("done:", "  ret void", "}");
+      host.declare(lines.join("\n"));
+    }
+    if (!layout || !layout.fields.length) continue;
+    const fieldsTrace = arms ? `${name}.fields` : trace;
+    const lines = [`define internal void ${fieldsTrace}(ptr %o, ptr %visit, ptr %ctx) {`, "entry:"];
+    const viewTarget =
+      value.kind === "record" && host.shapeHost.recordViews?.targets.has(value.shapeId);
+    if (viewTarget)
+      lines.push(
+        ...recordViewTestLines(host.sizeType, "%o", "%view"),
+        "  br i1 %view, label %done, label %fields",
+        "fields:",
+      );
+    layout.fields.forEach((field, index) => {
+      lines.push(
+        `  %p${index} = getelementptr inbounds %${layout.struct}, ptr %o, i32 0, i32 ${field.index}`,
+        `  %v${index} = load ptr, ptr %p${index}`,
+        `  call void %visit(ptr %v${index}, ptr ${symbol(field.type)}, ptr %ctx)`,
+      );
+    });
+    if (viewTarget) lines.push("  br label %done", "done:");
+    lines.push("  ret void", "}");
+    host.declare(lines.join("\n"));
+  }
+  return isRefCounted(type) ? symbol(type) : "null";
+}
