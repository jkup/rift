diff --git a/packages/compiler/src/ir/weak-map-types.test.ts b/packages/compiler/src/ir/weak-map-types.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..51f312a1d402353ef8c32fc43bc0d3f45df716da
--- /dev/null
+++ b/packages/compiler/src/ir/weak-map-types.test.ts
@@ -0,0 +1,61 @@
+import { expect, test } from "vitest";
+import { decodeFunctionBinary, encodeFunctionBinary } from "./codec.js";
+import {
+  F64,
+  STRING,
+  VOID,
+  POINTER_KINDS,
+  REF_TRUTHY_KINDS,
+  type IrFunction,
+  type IrType,
+  mapOf,
+  typeEquals,
+  typeKey,
+  weakMapOf,
+} from "./ir.js";
+import { everyTypeChild } from "./traverse.js";
+
+const key: IrType = { kind: "object", className: "Key" };
+
+test("weak map identity includes both slots and differs from strong maps", () => {
+  const type = weakMapOf(key, STRING);
+  expect(typeEquals(type, weakMapOf(key, STRING))).toBe(true);
+  expect(typeEquals(type, weakMapOf(key, F64))).toBe(false);
+  expect(typeEquals(type, weakMapOf({ kind: "object", className: "Other" }, STRING))).toBe(false);
+  expect(typeEquals(type, mapOf(key, STRING))).toBe(false);
+  expect(typeKey(type)).not.toBe(typeKey(mapOf(key, STRING)));
+  expect(POINTER_KINDS.has(type.kind)).toBe(true);
+  expect(REF_TRUTHY_KINDS.has(type.kind)).toBe(true);
+});
+
+test("type traversal reaches weak map keys and nested values", () => {
+  const nested = weakMapOf(key, weakMapOf(key, F64));
+  const visited: IrType[] = [];
+  const visit = (type: IrType): boolean => {
+    visited.push(type);
+    return everyTypeChild(type, visit);
+  };
+  expect(visit(nested)).toBe(true);
+  expect(visited.map(typeKey)).toEqual([
+    "weakMap<object:Key,weakMap<object:Key,f64>>",
+    "object:Key",
+    "weakMap<object:Key,f64>",
+    "object:Key",
+    "f64",
+  ]);
+});
+
+test("binary IR preserves nested weak maps beside strong maps", () => {
+  const fn: IrFunction = {
+    name: "types",
+    params: [],
+    returnType: VOID,
+    locals: [
+      { id: "weak", name: "weak", type: weakMapOf(key, mapOf(STRING, F64)), mutable: true },
+      { id: "strong", name: "strong", type: mapOf(key, weakMapOf(key, F64)), mutable: true },
+    ],
+    body: [],
+    loc: { file: "weak-map-types.ts", start: 0, end: 1 },
+  };
+  expect(decodeFunctionBinary(encodeFunctionBinary(fn))).toEqual(fn);
+});
