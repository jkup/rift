+  struct ScrTypedWeakEntry *next, *prev;
+} ScrTypedWeakEntry;
+
+struct ScrTypedWeakMap {
+  size_t rc;
+  const ScrWeakValueOps *ops;
+  const ScrOwnership *key_ownership, *value_ownership;
+  ScrTypedWeakEntry *entries;
+  bool traced_keys;
+  struct ScrTypedWeakMap *next, *prev;
+};
+static SCR_TL ScrTypedWeakMap *scr_typed_weak_maps;
+
+static void scr_typed_weak_detach(void *ptr) {
+  ScrTypedWeakEntry *entry = ptr;
+  ScrTypedWeakMap *map = entry->link.owner;
+  if (entry->next) entry->next->prev = entry->prev;
+  if (entry->prev) entry->prev->next = entry->next;
+  else map->entries = entry->next;
+  scr_weak_link_remove(&entry->link);
+  free(entry);
+}
+
+static void scr_typed_weak_remove(ScrTypedWeakEntry *entry, bool collected) {
+  ScrTypedWeakMap *map = entry->link.owner;
+  const ScrWeakValueOps *ops = map->ops;
+  uint64_t value = entry->value;
+  scr_typed_weak_detach(entry);
+  if (ops && (!collected || !ops->trace)) ops->release((void *)(uintptr_t)value);
+}
+
+static void scr_typed_weak_disposed(ScrWeakLink *link) {
+  bool collected = scr_cyc_color(scr_cyc_hdr(link->owner)) == SCR_CYC_DOOMED;
+  scr_typed_weak_remove((ScrTypedWeakEntry *)link, collected);
+}
+
+void scr_typed_weak_map_trace_v(void *object, ScrTraceVisit visit, void *ctx) {
+  ScrTypedWeakMap *map = object;
+  if (!map->ops || !map->ops->trace) return;
+  for (ScrTypedWeakEntry *entry = map->entries; entry; entry = entry->next)
+    visit((void *)(uintptr_t)entry->value, ctx);
+}
+
+static void scr_typed_weak_enumerate(ScrEphemeronVisit visit, void *ctx) {
+  for (ScrTypedWeakMap *map = scr_typed_weak_maps; map; map = map->next) {
+    for (ScrTypedWeakEntry *entry = map->entries; entry; entry = entry->next) {
+      ScrEphemeron edge = {
+        .owner = map, .key = entry->link.key, .entry = entry,
+        .value = map->ops ? (void *)(uintptr_t)entry->value : NULL,
+        .key_ownership = map->key_ownership, .value_ownership = map->value_ownership,
+        .key_traced = map->traced_keys, .value_traced = map->ops && map->ops->trace,
+        .detach = scr_typed_weak_detach, .release = map->ops ? map->ops->release : NULL,
+      };
+      visit(&edge, ctx);
+    }
+  }
+}
+
+static void scr_typed_weak_unregister(ScrTypedWeakMap *map) {
+  if (map->next) map->next->prev = map->prev;
+  if (map->prev) map->prev->next = map->next;
+  else scr_typed_weak_maps = map->next;
+}
+
+static void scr_typed_weak_gcfree(void *object) {
+  ScrTypedWeakMap *map = object;
+  scr_typed_weak_unregister(map);
+  scr_weak_dispose_inline(map);
+  while (map->entries) scr_typed_weak_remove(map->entries, true);
+  scr_cyc_free(map);
+}
+
+ScrTypedWeakMap *scr_typed_weak_map_new(bool traced_keys, const ScrWeakValueOps *ops) {
+  static ScrCycType type = { .trace = scr_typed_weak_map_trace_v, .free_fn = scr_typed_weak_gcfree, .kind = SCR_CYC_KIND_WEAK_MAP };
+  ScrTypedWeakMap *map = scr_cyc_alloc(sizeof *map, &type);
+  map->rc = 1;
+  map->ops = ops;
+  map->traced_keys = traced_keys;
+  map->next = scr_typed_weak_maps;
+  if (map->next) map->next->prev = map;
+  scr_typed_weak_maps = map;
+  static SCR_TL ScrEphemeronProvider provider = { scr_typed_weak_enumerate, NULL };
+  scr_ephemeron_register(&provider);
+  return map;
+}
+
+ScrTypedWeakMap *scr_typed_weak_map_new_owned(bool traced_keys, const ScrWeakValueOps *ops,
+    const ScrOwnership *key_ownership, const ScrOwnership *value_ownership) {
+  ScrTypedWeakMap *map = scr_typed_weak_map_new(traced_keys, ops);
+  map->key_ownership = key_ownership;
+  map->value_ownership = value_ownership;
+  return map;
+}
+
+ScrTypedWeakMap *scr_typed_weak_map_retain(ScrTypedWeakMap *map) {
+  if (map && !scr_rc_immortal(map)) SCR_RC_COUNT(map)++;
+  return map;
+}
+
+static void scr_typed_weak_destroy(void *object) {
+  ScrTypedWeakMap *map = object;
+  scr_typed_weak_unregister(map);
+  scr_weak_dispose_inline(map);
+  while (map->entries) scr_typed_weak_remove(map->entries, false);
+  scr_cyc_free(map);
+}
+
+void scr_typed_weak_map_release(ScrTypedWeakMap *map) {
+  if (!map || scr_rc_immortal(map)) return;
+  if (--SCR_RC_COUNT(map)) { scr_cyc_released(map); return; }
+  scr_cyc_dead(map);
+  scr_rc_destroy(map, scr_typed_weak_destroy);
+}
+
+static ScrTypedWeakEntry *scr_typed_weak_find(ScrTypedWeakMap *map, void *key) {
+  return (ScrTypedWeakEntry *)scr_weak_link_find(map, key, 0);
+}
+
+void scr_typed_weak_map_set(ScrTypedWeakMap *map, void *key, uint64_t value) {
+  if (!key) scr_trap("scriptc: null weak-map key\n");
+  ScrTypedWeakEntry *entry = scr_typed_weak_find(map, key);
+  if (entry) {
+    uint64_t old = entry->value;
+    entry->value = value;
+    if (map->ops) map->ops->release((void *)(uintptr_t)old);
+    return;
+  }
+  entry = calloc(1, sizeof *entry);
+  if (!entry) scr_trap("scriptc: out of memory\n");
+  entry->link = (ScrWeakLink){ .key = key, .owner = map, .dispose = scr_typed_weak_disposed };
+  entry->value = value;
+  entry->next = map->entries;
+  if (map->entries) map->entries->prev = entry;
+  map->entries = entry;
+  scr_weak_link_insert(&entry->link);
+}
+
+bool scr_typed_weak_map_get(ScrTypedWeakMap *map, void *key, uint64_t *value) {
+  ScrTypedWeakEntry *entry = scr_typed_weak_find(map, key);
+  if (!entry) return false;
+  uint64_t result = entry->value;
+  if (map->ops) result = (uint64_t)(uintptr_t)map->ops->retain((void *)(uintptr_t)result);
+  *value = result;
+  return true;
+}
+
+bool scr_typed_weak_map_has(ScrTypedWeakMap *map, void *key) {
+  return scr_typed_weak_find(map, key) != NULL;
+}
+
+bool scr_typed_weak_map_delete(ScrTypedWeakMap *map, void *key) {
+  ScrTypedWeakEntry *entry = scr_typed_weak_find(map, key);
+  if (!entry) return false;
+  scr_typed_weak_remove(entry, false);
+  return true;
+}
+
+void *scr_typed_weak_map_retain_v(void *map) { return scr_typed_weak_map_retain(map); }
+void scr_typed_weak_map_release_v(void *map) { scr_typed_weak_map_release(map); }
diff --git a/packages/runtime/src/scr_typed_weak_map.h b/packages/runtime/src/scr_typed_weak_map.h
new file mode 100644
index 0000000000000000000000000000000000000000..b507809892a4c8733e8b017e89de3d714494c0b1
--- /dev/null
+++ b/packages/runtime/src/scr_typed_weak_map.h
@@ -0,0 +1,33 @@
+/* scriptc runtime: typed weak-map storage (scr_typed_weak_map.c). */
+#ifndef SCR_TYPED_WEAK_MAP_H
+#define SCR_TYPED_WEAK_MAP_H
+
+#include "scr_ephemeron.h"
+
+typedef struct ScrTypedWeakMap ScrTypedWeakMap;
+typedef struct {
+  void *(*retain)(void *);
+  void (*release)(void *);
+  ScrTraceFn trace;
+} ScrWeakValueOps;
+
+/* Keys are borrowed native identities with disposal notifications. Values use
+ * raw scalar bits or reference pointers; set moves ownership, get returns +1.
+ * traced_keys identifies keys with collector headers.
+ * The immutable value descriptor must outlive the map. NULL means scalar. */
+ScrTypedWeakMap *scr_typed_weak_map_new(bool traced_keys, const ScrWeakValueOps *ops);
+/* Ownership descriptors outlive the map and describe the complete key/value
+ * graph. They supplement, rather than replace, the RC and cycle adapters. */
+ScrTypedWeakMap *scr_typed_weak_map_new_owned(bool traced_keys, const ScrWeakValueOps *ops,
+    const ScrOwnership *key_ownership, const ScrOwnership *value_ownership);
+ScrTypedWeakMap *scr_typed_weak_map_retain(ScrTypedWeakMap *map);
+void scr_typed_weak_map_release(ScrTypedWeakMap *map);
+void *scr_typed_weak_map_retain_v(void *map);
+void scr_typed_weak_map_release_v(void *map);
+void scr_typed_weak_map_trace_v(void *map, ScrTraceVisit visit, void *ctx);
+void scr_typed_weak_map_set(ScrTypedWeakMap *map, void *key, uint64_t value);
+bool scr_typed_weak_map_get(ScrTypedWeakMap *map, void *key, uint64_t *value);
+bool scr_typed_weak_map_has(ScrTypedWeakMap *map, void *key);
+bool scr_typed_weak_map_delete(ScrTypedWeakMap *map, void *key);
+
+#endif
diff --git a/packages/runtime/src/scr_weak_index.c b/packages/runtime/src/scr_weak_index.c
new file mode 100644
index 0000000000000000000000000000000000000000..8893611c68c7f7ec833a24b9fc477b4552935b7a
--- /dev/null
+++ b/packages/runtime/src/scr_weak_index.c
@@ -0,0 +1,174 @@
+#include "scr_weak_index.h"
+#include <stdlib.h>
+#include <string.h>
+
+static void scr_weak_link_disposed(void *key);
+static SCR_TL ScrWeakObserver scr_weak_link_observer = { scr_weak_link_disposed, NULL };
+#define SCR_WEAK_KEY_FILTER_BITS ((size_t)1 << 16)
+static SCR_TL uint64_t scr_weak_key_filter[SCR_WEAK_KEY_FILTER_BITS / 64];
+static inline size_t scr_weak_key_filter_bit(const void *key) {
+  return ((uintptr_t)key >> 4) & (SCR_WEAK_KEY_FILTER_BITS - 1);
+}
+
+static SCR_TL ScrWeakLink **scr_weak_index;
+static SCR_TL size_t scr_weak_index_mask, scr_weak_index_used;
+typedef struct { void *key; ScrWeakLink *head; } ScrWeakKeySlot;
+static SCR_TL ScrWeakKeySlot *scr_weak_keys;
+static SCR_TL size_t scr_weak_keys_mask, scr_weak_keys_used;
+
+/* Mixed in 64 bits on every target: uintptr_t is 32 bits on wasm32, where
+ * these shifts would exceed its width. */
+static inline size_t scr_weak_mix(uint64_t bits) {
+  bits ^= bits >> 33;
+  bits *= UINT64_C(0xff51afd7ed558ccd);
+  bits ^= bits >> 29;
+  return (size_t)bits;
+}
+static inline size_t scr_weak_entry_hash(const void *owner, const void *key, unsigned kind) {
+  return scr_weak_mix((uint64_t)(uintptr_t)key ^ ((uint64_t)(uintptr_t)owner * UINT64_C(0x9E3779B97F4A7C15)) ^
+                      ((uint64_t)kind << 56));
+}
+static inline size_t scr_weak_key_hash(const void *key) { return scr_weak_mix((uint64_t)(uintptr_t)key); }
+
+static void scr_weak_index_put(ScrWeakLink *entry) {
+  size_t j = scr_weak_entry_hash(entry->owner, entry->key, entry->kind) & scr_weak_index_mask;
+  while (scr_weak_index[j]) j = (j + 1) & scr_weak_index_mask;
+  scr_weak_index[j] = entry;
+}
+static void scr_weak_index_reserve(void) {
+  if (scr_weak_index && (scr_weak_index_used + 1) * 2 <= scr_weak_index_mask + 1) return;
+  ScrWeakLink **old = scr_weak_index;
+  size_t n = old ? scr_weak_index_mask + 1 : 0, cap = n ? n * 2 : 64;
+  scr_weak_index = calloc(cap, sizeof *scr_weak_index);
+  if (!scr_weak_index) scr_trap("scriptc: out of memory\n");
+  scr_weak_index_mask = cap - 1;
+  for (size_t i = 0; i < n; i++)
+    if (old[i]) scr_weak_index_put(old[i]);
+  free(old);
+}
+ScrWeakLink *scr_weak_link_find(void *map, void *ptr, unsigned kind) {
+  if (!scr_weak_index) return NULL;
+  for (size_t j = scr_weak_entry_hash(map, ptr, kind) & scr_weak_index_mask;; j = (j + 1) & scr_weak_index_mask) {
+    ScrWeakLink *entry = scr_weak_index[j];
+    if (!entry) return NULL;
+    if (entry->owner == map && entry->key == ptr && entry->kind == kind) return entry;
+  }
+}
+static void scr_weak_index_delete(ScrWeakLink *entry) {
+  size_t mask = scr_weak_index_mask;
+  size_t i = scr_weak_entry_hash(entry->owner, entry->key, entry->kind) & mask;
+  while (scr_weak_index[i] != entry) i = (i + 1) & mask;
+  if (--scr_weak_index_used == 0) {
+    /* Empty: give the table back, so a thread that exits leaves none. */
+    free(scr_weak_index);
+    scr_weak_index = NULL;
+    return;
+  }
+  for (size_t k = i;;) {
+    scr_weak_index[i] = NULL;
+    for (;;) {
+      k = (k + 1) & mask;
+      ScrWeakLink *e = scr_weak_index[k];
+      if (!e) return;
+      size_t home = scr_weak_entry_hash(e->owner, e->key, e->kind) & mask;
+      /* e stays unless its home lies cyclically outside (i, k]. */
+      if (i <= k ? (i < home && home <= k) : (i < home || home <= k)) continue;
+      scr_weak_index[i] = e;
+      i = k;
+      break;
+    }
+  }
+}
+
+static ScrWeakKeySlot *scr_weak_key_slot(const void *key) {
+  if (!scr_weak_keys) return NULL;
+  for (size_t j = scr_weak_key_hash(key) & scr_weak_keys_mask;; j = (j + 1) & scr_weak_keys_mask) {
+    if (scr_weak_keys[j].key == key) return &scr_weak_keys[j];
+    if (!scr_weak_keys[j].key) return NULL;
+  }
+}
+static ScrWeakKeySlot *scr_weak_key_slot_put(void *key) {
+  if (!scr_weak_keys || (scr_weak_keys_used + 1) * 2 > scr_weak_keys_mask + 1) {
+    ScrWeakKeySlot *old = scr_weak_keys;
+    size_t n = old ? scr_weak_keys_mask + 1 : 0, cap = n ? n * 2 : 64;
+    scr_weak_keys = calloc(cap, sizeof *scr_weak_keys);
+    if (!scr_weak_keys) scr_trap("scriptc: out of memory\n");
+    scr_weak_keys_mask = cap - 1;
+    for (size_t i = 0; i < n; i++) {
+      if (!old[i].key) continue;
+      size_t j = scr_weak_key_hash(old[i].key) & scr_weak_keys_mask;
+      while (scr_weak_keys[j].key) j = (j + 1) & scr_weak_keys_mask;
+      scr_weak_keys[j] = old[i];
+    }
+    free(old);
+  }
+  size_t j = scr_weak_key_hash(key) & scr_weak_keys_mask;
+  while (scr_weak_keys[j].key && scr_weak_keys[j].key != key) j = (j + 1) & scr_weak_keys_mask;
+  if (!scr_weak_keys[j].key) {
+    scr_weak_keys[j].key = key;
+    scr_weak_keys[j].head = NULL;
+    scr_weak_keys_used++;
+    size_t bit = scr_weak_key_filter_bit(key);
+    scr_weak_key_filter[bit >> 6] |= UINT64_C(1) << (bit & 63);
+  }
+  return &scr_weak_keys[j];
+}
+static void scr_weak_key_slot_delete(ScrWeakKeySlot *slot) {
+  size_t mask = scr_weak_keys_mask;
+  size_t i = (size_t)(slot - scr_weak_keys);
+  if (--scr_weak_keys_used == 0) {
+    free(scr_weak_keys);
+    scr_weak_keys = NULL;
+    memset(scr_weak_key_filter, 0, sizeof scr_weak_key_filter);
+    return;
+  }
+  for (size_t k = i;;) {
+    scr_weak_keys[i].key = NULL;
+    scr_weak_keys[i].head = NULL;
+    for (;;) {
+      k = (k + 1) & mask;
+      if (!scr_weak_keys[k].key) return;
+      size_t home = scr_weak_key_hash(scr_weak_keys[k].key) & mask;
+      if (i <= k ? (i < home && home <= k) : (i < home || home <= k)) continue;
+      scr_weak_keys[i] = scr_weak_keys[k];
+      i = k;
+      break;
+    }
+  }
+}
+
+/* Indexes a new entry (its key, kind and owner set) under its key. */
+void scr_weak_link_insert(ScrWeakLink *entry) {
+  scr_weak_observe(&scr_weak_link_observer);
+  scr_weak_index_reserve();
+  scr_weak_index_put(entry);
+  scr_weak_index_used++;
+  ScrWeakKeySlot *slot = scr_weak_key_slot_put(entry->key);
+  entry->key_prev = NULL;
+  entry->key_next = slot->head;
+  if (slot->head) slot->head->key_prev = entry;
+  slot->head = entry;
+}
+
+/* Unlink before the owner releases a value or frees the entry. */
+void scr_weak_link_remove(ScrWeakLink *entry) {
+  scr_weak_index_delete(entry);
+  if (entry->key_next) entry->key_next->key_prev = entry->key_prev;
+  if (entry->key_prev) entry->key_prev->key_next = entry->key_next;
+  else {
+    ScrWeakKeySlot *slot = scr_weak_key_slot(entry->key);
+    if (entry->key_next) slot->head = entry->key_next;
+    else scr_weak_key_slot_delete(slot);
+  }
+}
+
+static void scr_weak_link_disposed(void *key) {
+  size_t bit = scr_weak_key_filter_bit(key);
+  if (!(scr_weak_key_filter[bit >> 6] & (UINT64_C(1) << (bit & 63)))) return;
+  for (;;) {
+    ScrWeakKeySlot *slot = scr_weak_key_slot(key);
+    if (!slot) return;
+    ScrWeakLink *entry = slot->head;
+    entry->dispose(entry);
+  }
+}
