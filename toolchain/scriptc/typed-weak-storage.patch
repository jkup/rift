+import { encodeFunctionBinary, decodeFunctionBinary } from "../../ir/codec.js";
+import { assignLegacyTiers } from "../../ir/tiers.js";
+import { validateModule } from "../../ir/validate.js";
+import { everyExprChild, mapExprChildren } from "../../ir/traverse.js";
+import { emitLlvmModule } from "./emitter.js";
+
+const loc = { file: "weak-map.ts", start: 0, end: 1 };
+const key: IrType = { kind: "record", shapeId: "Key" };
+function moduleFor(value: IrExpr, unions: IrUnionDef[] = []): IrModule {
+  const valueType = value.type;
+  const map = weakMapOf(key, valueType);
+  const receiver: IrExpr = { kind: "varRef", localId: "map", type: map, loc };
+  const keyRef: IrExpr = { kind: "varRef", localId: "key", type: key, loc };
+  const optional: IrType = { kind: "union", unionId: "Optional" };
+  const mod: IrModule = {
+    irVersion: 17,
+    sourceFile: loc.file,
+    entry: "main",
+    records: [{ id: "Key", fields: [] }],
+    unions: [
+      ...unions,
+      {
+        id: "Optional",
+        arms: [
+          ...(valueType.kind === "union"
+            ? unions
+                .find((u) => u.id === valueType.unionId)!
+                .arms.filter((a) => a.kind !== "undefinedT")
+            : [value.type]),
+          UNDEFINED_T,
+        ],
+      },
+    ],
+    functions: [
+      {
+        name: "main",
+        params: [],
+        returnType: VOID,
+        loc,
+        locals: [
+          { id: "map", name: "map", type: map, mutable: false },
+          { id: "key", name: "key", type: key, mutable: false },
+        ],
+        body: [
+          {
+            kind: "varDecl",
+            localId: "key",
+            init: { kind: "recordLit", fields: [], type: key, loc },
+            loc,
+          },
+          { kind: "varDecl", localId: "map", init: { kind: "weakMapNew", type: map, loc }, loc },
+          ...(["set", "get", "has", "delete"] as const).map((method) => ({
+            kind: "exprStmt" as const,
+            loc,
+            expr: {
+              kind: "weakMapIntrinsic" as const,
+              method,
+              receiver,
+              args: method === "set" ? [keyRef, value] : [keyRef],
+              type: method === "set" ? VOID : method === "get" ? optional : BOOL,
+              loc,
+            },
+          })),
+        ],
+      },
+    ],
+  };
+  assignLegacyTiers(mod.functions);
+  return mod;
+}
+
+test.each([
+  { kind: "numLit", value: 7, type: F64, loc },
+  { kind: "boolLit", value: true, type: BOOL, loc },
+  { kind: "strLit", value: "value", type: STRING, loc },
+  { kind: "varRef", localId: "key", type: key, loc },
+] satisfies IrExpr[])(
+  "typed weak-map IR validates, roundtrips and emits native calls for $type.kind",
+  (value) => {
+    const mod = moduleFor(value);
+    expect(validateModule(mod)).toEqual([]);
+    expect(decodeFunctionBinary(encodeFunctionBinary(mod.functions[0]!))).toEqual(mod.functions[0]);
+    for (const options of [{}, { wasi: true, pointerBits: 32 as const }]) {
+      const llvm = emitLlvmModule(mod, options);
+      for (const method of ["new_owned", "set", "get", "has", "delete"])
+        expect(llvm).toContain("@scr_typed_weak_map_" + method + "(");
+      expect(llvm).not.toContain("@scr_weak_map_new(");
+      expect(llvm).toContain("@sc_weak_keys = internal constant i1 true");
+    }
+  },
+);
+
+test("weak-map traversal preserves receiver, key and value evaluation order", () => {
+  const mod = moduleFor({ kind: "numLit", value: 7, type: F64, loc });
+  const statement = mod.functions[0]!.body[2]!;
+  if (statement.kind !== "exprStmt") throw new Error("missing set");
+  const children: IrExpr[] = [];
+  everyExprChild(
+    statement.expr,
+    (e) => {
+      children.push(e);
+      return true;
+    },
+    () => true,
+  );
+  expect(children.map((e) => e.kind)).toEqual(["varRef", "varRef", "numLit"]);
+  const mapped = mapExprChildren(
+    statement.expr,
+    (e) => (e.kind === "numLit" ? { ...e, value: 9 } : e),
+    (statement) => statement,
+  );
+  expect(mapped.kind === "weakMapIntrinsic" && mapped.args[1]).toMatchObject({ value: 9 });
+});
+
+test("weak-map validation rejects wrong result and argument types", () => {
+  const mod = moduleFor({ kind: "numLit", value: 7, type: F64, loc });
+  const statement = mod.functions[0]!.body[2]!;
+  if (statement.kind !== "exprStmt" || statement.expr.kind !== "weakMapIntrinsic")
+    throw new Error("missing set");
+  statement.expr.args[1] = { kind: "strLit", value: "wrong", type: STRING, loc };
+  statement.expr.type = BOOL;
+  const errors = validateModule(mod)
+    .map((error) => error.message)
+    .join("\n");
+  expect(errors).toContain("weakMapIntrinsic set arg 1");
+  expect(errors).toContain("weakMapIntrinsic set result");
+});
+
+test.each([NULL_T, UNDEFINED_T])(
+  "weak-map get preserves stored $kind values when widening its result",
+  (unit) => {
+    const stored: IrType = { kind: "union", unionId: "Stored" };
+    const value: IrExpr = {
+      kind: "unionWrap",
+      unionId: "Stored",
+      tag: 0,
+      value: { kind: "varRef", localId: "key", type: key, loc },
+      type: stored,
+      loc,
+    };
+    const mod = moduleFor(value, [{ id: "Stored", arms: [key, unit] }]);
+    expect(validateModule(mod)).toEqual([]);
+    expect(() => emitLlvmModule(mod)).not.toThrow();
+  },
+);
diff --git a/packages/compiler/src/backend/llvm/expr-weak-map.ts b/packages/compiler/src/backend/llvm/expr-weak-map.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4d5523c6d21b12a8510173e689b33353cd64bd2f
--- /dev/null
+++ b/packages/compiler/src/backend/llvm/expr-weak-map.ts
@@ -0,0 +1,125 @@
+import { InternalCompilerError } from "../../errors.js";
+import { undefinedArmTag } from "../../ir/analysis.js";
+import { isRefCounted, type IrExpr, typeEquals } from "../../ir/ir.js";
+import type { LlvmEmitterContext, LlValue } from "./expr-context.js";
+import { emitUnionWiden } from "./expr-records.js";
+import { traceArg, vAdapters } from "./shapes.js";
+import { ownershipDescriptor } from "./ownership.js";
+
+export function emitWeakMapNew(
+  host: LlvmEmitterContext,
+  e: IrExpr & { kind: "weakMapNew" },
+): LlValue {
+  if (e.type.kind !== "weakMap")
+    throw new InternalCompilerError("weakMapNew requires weakMap type");
+  const { key, value } = e.type;
+  let ops = "null";
+  if (isRefCounted(value)) {
+    const rc = vAdapters(host.shapeHost, value);
+    ops = host.mapOps([rc.retain, rc.release, traceArg(host.shapeHost, value)]);
+  }
+  const traced = traceArg(host.shapeHost, key) !== "null";
+  const result = host.B.tmp();
+  const keyOwnership = ownershipDescriptor(host, key);
+  const valueOwnership = ownershipDescriptor(host, value);
+  if (keyOwnership !== null && valueOwnership !== null) {
+    host.declare("declare ptr @scr_typed_weak_map_new_owned(i1 zeroext, ptr, ptr, ptr)");
+    host.B.line(
+      `${result} = call ptr @scr_typed_weak_map_new_owned(i1 ${traced}, ptr ${ops}, ptr ${keyOwnership}, ptr ${valueOwnership})`,
+    );
+  } else {
+    host.declare("declare ptr @scr_typed_weak_map_new(i1 zeroext, ptr)");
+    host.B.line(`${result} = call ptr @scr_typed_weak_map_new(i1 ${traced}, ptr ${ops})`);
+  }
+  return host.own({ name: result, type: e.type });
+}
+
+export function emitWeakMapIntrinsic(
+  host: LlvmEmitterContext,
+  e: IrExpr & { kind: "weakMapIntrinsic" },
+): LlValue {
+  const type = e.receiver.type;
+  if (type.kind !== "weakMap")
+    throw new InternalCompilerError("weak-map method requires weakMap receiver");
+  const B = host.B;
+  // Keep receiver and key alive while evaluating later arguments and releasing replaced values.
+  const receiver = host.emitExpr(e.receiver);
+  const key = host.emitExpr(e.args[0]!);
+  let identity = key.name;
+  if (key.type.kind === "dyn") {
+    if (e.method === "set")
+      throw new InternalCompilerError("typed weak-map set requires a native key");
+    identity = B.tmp();
+    host.declare("declare ptr @scr_dyn_weak_native_key(ptr)");
+    B.line(`${identity} = call ptr @scr_dyn_weak_native_key(ptr ${key.name})`);
+  }
+  if (e.method === "set") {
+    const value = host.emitExpr(e.args[1]!);
+    if (isRefCounted(type.value)) host.toHeap(value);
+    const bits = B.tmp();
+    B.line(
+      type.value.kind === "f64"
+        ? `${bits} = bitcast double ${value.name} to i64`
+        : type.value.kind === "bool"
+          ? `${bits} = zext i1 ${value.name} to i64`
+          : `${bits} = ptrtoint ptr ${value.name} to i64`,
+    );
+    host.declare("declare void @scr_typed_weak_map_set(ptr, ptr, i64)");
+    B.line(`call void @scr_typed_weak_map_set(ptr ${receiver.name}, ptr ${identity}, i64 ${bits})`);
+    return { name: "", type: e.type };
+  }
+  if (e.method === "has" || e.method === "delete") {
+    const result = B.tmp();
+    const symbol = `scr_typed_weak_map_${e.method}`;
+    host.declare(`declare zeroext i1 @${symbol}(ptr, ptr)`);
+    B.line(`${result} = call zeroext i1 @${symbol}(ptr ${receiver.name}, ptr ${identity})`);
+    return { name: result, type: e.type };
+  }
+  if (e.type.kind !== "union")
+    throw new InternalCompilerError("weak-map get requires optional result");
+  const def = host.unionsById.get(e.type.unionId);
+  const absentTag = undefinedArmTag(e.type, host.unionsById);
+  if (!def || absentTag < 0) throw new InternalCompilerError("weak-map get result lacks undefined");
+  const output = B.slot();
+  const resultSlot = B.slot();
+  B.entryAllocas.push(`${output} = alloca i64`, `${resultSlot} = alloca ptr`);
+  const found = B.tmp();
+  host.declare("declare zeroext i1 @scr_typed_weak_map_get(ptr, ptr, ptr)");
+  B.line(
+    `${found} = call zeroext i1 @scr_typed_weak_map_get(ptr ${receiver.name}, ptr ${identity}, ptr ${output})`,
+  );
+  const present = B.newLabel("weak.present"),
+    absent = B.newLabel("weak.absent"),
+    done = B.newLabel("weak.done");
+  B.condBr(found, present, absent);
+  B.startBlock(present);
+  const bits = B.tmp(),
+    value = B.tmp();
+  B.line(`${bits} = load i64, ptr ${output}`);
+  B.line(
+    type.value.kind === "f64"
+      ? `${value} = bitcast i64 ${bits} to double`
+      : type.value.kind === "bool"
+        ? `${value} = trunc i64 ${bits} to i1`
+        : `${value} = inttoptr i64 ${bits} to ptr`,
+  );
+  let wrapped: string;
+  if (type.value.kind === "union") {
+    wrapped = typeEquals(type.value, e.type)
+      ? value
+      : emitUnionWiden(host, value, type.value.unionId, e.type.unionId, true);
+  } else {
+    const tag = def.arms.findIndex((arm) => typeEquals(arm, type.value));
+    if (tag < 0) throw new InternalCompilerError("weak-map get result lacks value arm");
+    wrapped = host.unionNewOwned(e.type.unionId, tag, { name: value, type: type.value });
+  }
+  B.line(`store ptr ${wrapped}, ptr ${resultSlot}`);
+  B.br(done);
+  B.startBlock(absent);
+  B.line(`store ptr ${host.unitInstanceRef(e.type.unionId, absentTag)}, ptr ${resultSlot}`);
+  B.br(done);
+  B.startBlock(done);
+  const result = B.tmp();
+  B.line(`${result} = load ptr, ptr ${resultSlot}`);
+  return host.own({ name: result, type: e.type });
+}
