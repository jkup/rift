+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, test } from "vitest";
+import { compile, deserializeModule } from "../src/index.js";
+import { everyModuleNode } from "../src/ir/traverse.js";
+
+const programs = [
+  `class Key { n = 1; }
+const key = new Key();
+const inner = new WeakMap<Key, number>();
+inner.set(key, 7);
+const container = new Map<string, Key | WeakMap<Key, number>>();
+container.set("key", key); container.set("map", inner);
+console.log(container.get("map") === inner, container.get("key") === key, container.get("missing") === undefined);`,
+  `class Key { peer: Key | null = null; }
+const key = new Key();
+const map = new WeakMap<Key, Key>();
+console.log(map.set(key, key) === map, map.get(key) === key, map.has(key), map.delete(key));`,
+  `const key = { name: "key" };
+const map = new WeakMap<{ name: string }, string>();
+map.set(key, "value");
+console.log(map.get(key), map.has(key), map.delete(key));`,
+  `class Key { n = 1; }
+const key = new Key();
+const inner = new WeakMap<Key, number>();
+const outer = new WeakMap<Key, WeakMap<Key, number>>();
+inner.set(key, 7); outer.set(key, inner);
+console.log(outer.get(key) === inner, inner.get(key));`,
+  `class Key { n = 1; }
+const key = new Key();
+let order = "";
+function mark(value: string): string { order += value; return value; }
+const map = new WeakMap<Key, string>([[key, mark("first")], [key, mark("last")]]);
+console.log(order, map.get(key), map.has(key), map.delete(key), map.get(key));`,
+  `const key = { name: "key" };
+const first = { value: 1 }, last = { value: 2 };
+const entries: [{ name: string }, { value: number }][] = [[key, first], [key, last]];
+const map = new WeakMap(entries);
+entries.pop();
+console.log(map.get(key) === last, map.has(key), entries.length);`,
+  `class Key { n = 1; }
+const key = new Key();
+let calls = 0;
+function empty(): undefined { calls++; return undefined; }
+const a = new WeakMap<Key, number>(empty());
+const b = new WeakMap<Key, number>(null);
+const c = new WeakMap<Key, number>([]);
+console.log(calls, a.has(key), b.has(key), c.has(key));`,
+  `class Key { n = 1; }
+const key = new Key();
+const map = new WeakMap<Key, number>();
+map.set(key, 1);
+let calls = 0;
+function pick(flag: boolean): WeakMap<Key, number> | null { calls++; return flag ? map : null; }
+console.log(map instanceof WeakMap, map instanceof WeakSet, map instanceof Map, map instanceof Key);
+console.log(pick(true) instanceof WeakMap, pick(false) instanceof WeakMap, calls);
+console.log(Object.is(map, map), Object.is(map, new WeakMap<Key, number>()));`,
+];
+
+test.each(programs)(
+  "native key/value WeakMaps lower without dynamic storage: %s",
+  async (source) => {
+    const directory = await mkdtemp(join(tmpdir(), "scriptc-typed-weak-map-"));
+    try {
+      const entry = join(directory, "main.ts"),
+        outPath = join(directory, "main.ir.json");
+      await writeFile(entry, source);
+      const result = await compile(entry, { outDir: directory, outPath, outputKind: "ir" });
+      expect(result.ok, JSON.stringify(result.diagnostics)).toBe(true);
+      if (!result.ok) return;
+      const mod = deserializeModule(await readFile(outPath, "utf8"));
+      const operations: string[] = [];
+      everyModuleNode(mod, {
+        expr: (node) => {
+          operations.push(node.kind);
+          return true;
+        },
+        stmt: () => true,
+        type: () => true,
+      });
+      expect(operations).toContain("weakMapNew");
+      expect(operations).toContain("weakMapIntrinsic");
+      expect(operations).not.toContain("dynInvoke");
+      expect(mod.functions.every((fn) => fn.tier !== "dynamic")).toBe(true);
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  },
+);
+
+test.each([
+  ["stream-typed-chunk-weakmap.ts", ["get"]],
+  ["typed-weak-map-dynamic-lookups.ts", ["delete", "get", "has"]],
+] as const)("typed WeakMap lookups keep dynamic key identities: %s", async (file, methods) => {
+  const directory = await mkdtemp(join(tmpdir(), "scriptc-weak-stream-"));
+  try {
+    const entry = new URL(`../../../tests/corpus/${file}`, import.meta.url);
+    const outPath = join(directory, "stream.ir.json");
+    const { fileURLToPath } = await import("node:url");
+    const result = await compile(fileURLToPath(entry), {
+      outDir: directory,
+      outPath,
+      outputKind: "ir",
+    });
+    expect(result.ok, JSON.stringify(result.diagnostics)).toBe(true);
+    if (!result.ok) return;
+    const mod = deserializeModule(await readFile(outPath, "utf8"));
+    const lookups = new Set<string>();
+    everyModuleNode(mod, {
+      expr: (node) => {
+        if (node.kind === "weakMapIntrinsic" && node.args[0]?.type.kind === "dyn")
+          lookups.add(node.method);
+        return true;
+      },
+      stmt: () => true,
+      type: () => true,
+    });
+    expect([...lookups].sort()).toEqual(methods);
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+});
