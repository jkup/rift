diff --git a/packages/runtime/test/typed-weak-map.test.ts b/packages/runtime/test/typed-weak-map.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b6a2cffd46d6a01f939c730f91b1ad2142a12a08
--- /dev/null
+++ b/packages/runtime/test/typed-weak-map.test.ts
@@ -0,0 +1,54 @@
+import { execFile } from "node:child_process";
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import { expect, test } from "vitest";
+
+const execFileAsync = promisify(execFile);
+const testDir = import.meta.dirname;
+
+test.each([false, true])(
+  "typed weak maps preserve ownership and teardown (nursery=%s)",
+  async (nursery) => {
+    const buildDir = join(testDir, "build");
+    await mkdir(buildDir, { recursive: true });
+    const windows = process.platform === "win32";
+    const bin = join(
+      buildDir,
+      `test_typed_weak_map_${nursery ? "nursery" : "default"}${windows ? ".exe" : ""}`,
+    );
+    await execFileAsync(windows ? "zig" : "clang", [
+      ...(windows ? ["cc"] : []),
+      "-std=c11",
+      ...(nursery ? ["-DSCR_YIN"] : []),
+      "-O1",
+      "-Wall",
+      "-Wextra",
+      "-ffunction-sections",
+      "-fdata-sections",
+      process.platform === "darwin" ? "-Wl,-dead_strip" : "-Wl,--gc-sections",
+      ...(windows ? [] : ["-fsanitize=address,undefined"]),
+      "-o",
+      bin,
+      join(testDir, "test_typed_weak_map.c"),
+      join(testDir, "../src/scr_weak_index.c"),
+      join(testDir, "../src/scr_ephemeron.c"),
+      join(testDir, "../src/scr_typed_weak_map.c"),
+      join(testDir, "../src/scr_cycle.c"),
+      join(testDir, "../src/scr_alloc.c"),
+    ]);
+    for (const threshold of [undefined, "1", "7"]) {
+      const env = {
+        ...process.env,
+        ASAN_OPTIONS: "detect_leaks=0:halt_on_error=1",
+        UBSAN_OPTIONS: "halt_on_error=1",
+      };
+      delete env.SCR_CYCLE_THRESHOLD;
+      delete env.SCR_CYCLE_GROWTH_CAP;
+      if (threshold !== undefined) env.SCR_CYCLE_THRESHOLD = threshold;
+      const run = await execFileAsync(bin, [], { env });
+      expect(run.stdout.replaceAll("\r\n", "\n")).toBe("typed weak map checks passed\n");
+      expect(run.stderr).toBe("");
+    }
+  },
+);
