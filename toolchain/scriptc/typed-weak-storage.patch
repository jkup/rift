+import * as ts from "../../ts7/adapter.js";
+import { locOf } from "../../program.js";
+import { BOOL, VOID, type IrExpr } from "../../../ir/ir.js";
+import { varRef } from "../../../ir/build.js";
+import type { Lowerer } from "../lowerer.js";
+
+export function lowerWeakMapMethodCall(
+  lowerer: Lowerer,
+  call: ts.CallExpression,
+  access: ts.PropertyAccessExpression,
+): IrExpr | null {
+  if (lowerer.chainBlocked(access, call)) return null;
+  const method = access.name.text;
+  if (method !== "get" && method !== "set" && method !== "has" && method !== "delete") return null;
+  const type = lowerer.mapTypeOf(lowerer.typeOf(access.expression));
+  if (type?.kind !== "weakMap" || !lowerer.isStdlibMember(access)) return null;
+  const arguments_ = call.arguments.nodes;
+  if (arguments_.length !== (method === "set" ? 2 : 1) || arguments_.some(ts.isSpreadElement))
+    lowerer.noLowering("typed WeakMap calls with missing, surplus or spread arguments", call);
+  const loc = locOf(call);
+  const receiver = lowerer.lowerExpr(access.expression);
+  const keyNode = arguments_[0]!;
+  const key =
+    method !== "set" &&
+    ((lowerer.typeOf(keyNode).flags & (ts.TypeFlags.Any | ts.TypeFlags.Unknown)) !== 0 ||
+      lowerer.mapTypeOf(lowerer.typeOf(keyNode))?.kind === "dyn")
+      ? lowerer.lowerExpr(keyNode)
+      : lowerer.lowerCollectionKey(keyNode, type.key);
+  if (method === "get") {
+    const result = lowerer.withUndefinedArmOf(type.value) ?? lowerer.withUndefinedArm(type.value);
+    return { kind: "weakMapIntrinsic", method, receiver, args: [key], type: result, loc };
+  }
+  if (method === "has" || method === "delete")
+    return { kind: "weakMapIntrinsic", method, receiver, args: [key], type: BOOL, loc };
+  const value = lowerer.lowerExprExpecting(arguments_[1]!, type.value);
+  let parent = call.parent;
+  while (ts.isParenthesizedExpression(parent)) parent = parent.parent;
+  if (ts.isExpressionStatement(parent))
+    return { kind: "weakMapIntrinsic", method, receiver, args: [key, value], type: VOID, loc };
+  const slot = lowerer.declareHiddenLocal("%weakMapSetReceiver", type);
+  const ref = varRef(slot.id, type, loc);
+  return {
+    kind: "seqExpr",
+    stmts: [
+      { kind: "varDecl", localId: slot.id, init: receiver, loc },
+      {
+        kind: "exprStmt",
+        expr: {
+          kind: "weakMapIntrinsic",
+          method,
+          receiver: ref,
+          args: [key, value],
+          type: VOID,
+          loc,
+        },
+        loc,
+      },
+    ],
+    result: ref,
+    type,
+    loc,
+  };
+}
