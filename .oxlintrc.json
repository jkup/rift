{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "oxc", "unicorn"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "curly": ["error", "all"],
        "no-nested-ternary": "error",
        "no-sequences": "error",
        "no-cond-assign": ["error", "always"],
        "no-eval": "error",
        "no-new-func": "error",
        "typescript/no-explicit-any": "error",
        "no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "caughtErrorsIgnorePattern": "^_"
            }
        ],
        "typescript/no-this-alias": "off",
        "unicorn/no-thenable": "off",
        "unicorn/no-new-array": "off",
        "no-restricted-globals": ["error", "eval", "Function"],
        "no-restricted-imports": [
            "error",
            {
                "paths": ["vm", "node:vm"]
            }
        ]
    },
    "ignorePatterns": [
        "build/**",
        "node_modules/**",
        ".cache/**",
        ".scriptc/**",
        "docs/**",
        "test/fixtures/**",
        "examples/**",
        "src/time-zone/iana-timezone-data.ts",
        "src/time-zone/iana-timezone-identifiers.ts",
        "src/unicode/unicode-properties.ts",
        "src/unicode/unicode-identifiers.ts",
        "src/unicode/unicode-case-fold.ts"
    ],
    "overrides": [
        {
            "files": ["src/**/*.ts"],
            "excludeFiles": [
                "src/cli.ts",
                "src/host/observation-driver.ts",
                "src/host/script-observation-driver.ts",
                "src/host/script-observation.ts"
            ],
            "rules": {
                "no-console": "error",
                "no-restricted-globals": ["error", "eval", "Function", "process", "require"]
            }
        }
    ]
}
