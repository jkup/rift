{
  "name": "rift",
  "version": "1.0.0",
  "description": "A minimal JavaScript runtime written in C++",
  "type": "module",
  "main": "test262-runner.js",
  "scripts": {
    "build": "./build.sh",
    "test": "node test-runner.js",
    "test262": "node test262-runner.js",
    "test262:group": "node test262-group-runner.js",
    "test262:groups": "node test262-group-runner.js --list",
    "test262:all-groups": "node test262-group-runner.js --all",
    "test262:analyze": "node test262-impact-analyzer.js",
    "playground": "./build/rift test/test-file.js",
    "benchmark": "./bench/benchmark.sh",
    "clean": "rm -rf build test262",
    "repl": "cd repl && ./run.sh"
  },
  "keywords": [
    "javascript",
    "runtime",
    "interpreter",
    "c++",
    "test262"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-boxes": "^3.0.0"
  }
}
